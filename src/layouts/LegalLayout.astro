---
import BaseLayout from "./BaseLayout.astro"
import LegalNav from "../components/nav/LegalNav.astro"
import Footer from "../components/sections/Footer.astro"
import { formatDate } from "../utils/readingTime"
import { jsonLdScript } from "../i18n/jsonLd"
import type { Locale } from "../i18n/locales"
import { localizedPath, type AlternateLink } from "../i18n/routing"
import type { Messages } from "../i18n/messages/schema"
import { t } from "../i18n/messages/schema"

type ActivePage = "terms" | "privacy" | "cookies" | "disclaimer"

type Props = {
    locale: Locale
    messages: Messages
    alternates: AlternateLink[]
    robotsDirectives?: string
    title: string
    description: string
    canonicalPath: string
    ogImagePath?: string
    activeNav: ActivePage
    contentHtml: string
}

const {
    locale,
    messages,
    alternates,
    robotsDirectives,
    title,
    description,
    canonicalPath,
    ogImagePath = "/og.jpg",
    activeNav,
    contentHtml,
} = Astro.props

const canonicalUrl = new URL(canonicalPath, Astro.site).toString()

const decodeHtmlEntities = (value: string) =>
    value
        .replaceAll("&amp;", "&")
        .replaceAll("&lt;", "<")
        .replaceAll("&gt;", ">")
        .replaceAll("&quot;", '"')
        .replaceAll("&#39;", "'")
        .replaceAll("&apos;", "'")

const stripTags = (value: string) =>
    decodeHtmlEntities(value.replace(/<[^>]*>/g, "")).trim()

const metadataComments: Record<string, string> = {}
const withoutMetadataComments = contentHtml.replace(
    /^(\s*<!--\s*(lastUpdated|translationStatus):\s*([\s\S]*?)\s*-->\s*)+/u,
    (match) => {
        for (const comment of match.matchAll(/<!--\s*(lastUpdated|translationStatus):\s*([\s\S]*?)\s*-->/gu)) {
            metadataComments[comment[1]] = comment[2].trim()
        }
        return ""
    },
)

const withoutTitle = (() => {
    const match = contentHtml.match(
        new RegExp("<h1\\b[^>]*>[\\s\\S]*?</h1>", "i")
    )
    if (!match) return { titleText: undefined, html: withoutMetadataComments }
    return {
        titleText: stripTags(
            match[0].replace(new RegExp("</?h1\\b[^>]*>", "gi"), "")
        ),
        html: withoutMetadataComments.replace(match[0], ""),
    }
})()

const withoutUpdated = (() => {
    const match = withoutTitle.html.match(
        new RegExp("<p\\b[^>]*>[\\s\\S]*?Last updated:[\\s\\S]*?</p>", "i")
    )
    if (!match) return { updatedAtText: undefined, html: withoutTitle.html }

    const updatedAtText = stripTags(match[0])

    return {
        updatedAtText,
        html: withoutTitle.html.replace(match[0], ""),
    }
})()

const pageTitle =
    withoutTitle.titleText ??
    title.replace(/\u00a0/g, " ").replace(/\\s*-\\s*Duet Mail\\s*$/i, "").trim()

const updatedAtDate = (() => {
    if (metadataComments.lastUpdated) {
        const date = new Date(`${metadataComments.lastUpdated}T00:00:00.000Z`)
        if (Number.isNaN(date.getTime())) {
            throw new Error(`Invalid legal lastUpdated metadata for ${canonicalPath}: ${metadataComments.lastUpdated}`)
        }
        return date
    }
    if (withoutUpdated.updatedAtText) return undefined
    throw new Error(`Missing legal lastUpdated metadata for ${canonicalPath}`)
})()
const updatedAt = updatedAtDate
    ? t(messages, "legal.lastUpdated", { date: formatDate(updatedAtDate, locale) })
    : withoutUpdated.updatedAtText
const bodyHtml = withoutUpdated.html.trim()
const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    inLanguage: locale,
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: t(messages, "legalNav.home"),
            item: new URL(localizedPath(locale, { kind: "home" }), Astro.site).toString(),
        },
        {
            "@type": "ListItem",
            position: 2,
            name: pageTitle,
            item: canonicalUrl,
        },
    ],
}
const pageJsonLd = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    inLanguage: locale,
    name: pageTitle,
    description,
    url: canonicalUrl,
}
const extraHeadHtml = `${jsonLdScript(pageJsonLd)}\n${jsonLdScript(breadcrumbJsonLd)}`
---

<BaseLayout
    title={title}
    description={description}
    canonicalPath={canonicalPath}
    ogImagePath={ogImagePath}
    locale={locale}
    alternates={alternates}
    robotsDirectives={robotsDirectives}
    extraHeadHtml={extraHeadHtml}
>
    <LegalNav active={activeNav} locale={locale} messages={messages} alternates={alternates} />

    <main class="relative isolate">
        <div class="mx-auto max-w-4xl px-6 pt-28 pb-20 md:px-10">
            <header class="legal-header">
                <h1 class="legal-title">{pageTitle}</h1>
                {updatedAt ? <p class="legal-updated">{updatedAt}</p> : null}
            </header>

            <div class="legal-surface">
                <div class="duet-prose" set:html={bodyHtml} />
            </div>
        </div>
    </main>

    <Footer locale={locale} messages={messages} />
</BaseLayout>

<style>
    .legal-header {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 28px;
    }

    .legal-title {
        margin: 0;
        font-family: "Manrope Variable", ui-sans-serif, system-ui, -apple-system,
            BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial;
        font-size: 40px;
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.1;
        color: var(--prose-heading);
        text-wrap: balance;
    }

    @media (max-width: 767px) {
        .legal-title {
            font-size: 32px;
        }
    }

    .legal-updated {
        margin: 0;
        font-family: "Manrope Variable", ui-sans-serif, system-ui, -apple-system,
            BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--duet-muted);
    }

    .legal-surface {
        border: 1px solid var(--duet-border);
        background: rgba(0, 0, 0, 0.22);
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    :global(html[data-theme="light"]) .legal-surface {
        background: rgba(255, 255, 255, 0.7);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    @media (max-width: 767px) {
        .legal-surface {
            padding: 18px;
        }
    }
</style>
