---
import "../styles/global.css";
import consentDefaultHtml from "../snippets/consent-default.html?raw";
import gtmHeadHtml from "../snippets/gtm-head.html?raw";
import gtmNoscriptHtml from "../snippets/gtm-noscript.html?raw";
import consentBannerHtml from "../snippets/consent-banner.html?raw";
import { SITE_BRAND, renderConsentBanner } from "../utils/brand";
import {
    DEFAULT_LOCALE,
    OPEN_GRAPH_LOCALES,
    SUPPORTED_LOCALES,
    isRuntimeLocale,
    type Locale,
    type RenderLocale,
} from "../i18n/locales";
import type { AlternateLink } from "../i18n/routing";

type Props = {
    title: string;
    description: string;
    canonicalPath: string;
    ogImagePath: string;
    ogImageAlt?: string;
    locale: RenderLocale;
    alternates: AlternateLink[];
    extraHeadHtml?: string;
    ogType?: "website" | "article";
    robotsDirectives?: string;
};

const {
    title,
    description,
    canonicalPath,
    ogImagePath,
    ogImageAlt = title,
    locale = DEFAULT_LOCALE,
    alternates = [],
    extraHeadHtml,
    ogType = "website",
    robotsDirectives,
} =
    Astro.props;

// Ensure canonical path does NOT have a trailing slash to match Astro's trailingSlash: "never" config
const normalizedPath = (() => {
    if (canonicalPath === "/") return "/";
    return canonicalPath.endsWith("/") ? canonicalPath.slice(0, -1) : canonicalPath;
})();
const canonicalUrl = new URL(normalizedPath, Astro.site).toString();
const ogImageUrl = new URL(ogImagePath, Astro.site).toString();
const runtimeOgLocale = isRuntimeLocale(locale) ? locale : undefined;
const runtimeAlternateLocales = alternates.filter(
    (alternate): alternate is AlternateLink & { locale: Locale } =>
        alternate.locale !== "x-default" && isRuntimeLocale(alternate.locale),
);
const shouldEmitOgLocaleAlternates =
    runtimeAlternateLocales.length === SUPPORTED_LOCALES.length &&
    runtimeAlternateLocales.length > 1 && !robotsDirectives?.includes("noindex");

// Consent banner: interpolate the host-aware brand + privacy href into the
// English-only snippet (SC-1 / B3). The privacy page is same-origin on both
// brands (/privacy), built from SITE_URL so the chiefy build points at chiefy.com.
const consentBannerRendered = renderConsentBanner(consentBannerHtml);
---

<!doctype html>
<html lang={locale} data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Consent Mode v2 default (SC-1) — MUST precede the GTM bootstrap. -->
        <Fragment set:html={consentDefaultHtml} />
        <Fragment set:html={gtmHeadHtml} />

        <script is:inline>
            (() => {
                const safeLocalStorageGet = (key) => {
                    try {
                        return localStorage.getItem(key);
                    } catch (error) {
                        return null;
                    }
                };

                const getTheme = () => {
                    const storedTheme = safeLocalStorageGet("theme");
                    if (storedTheme === "dark") {
                        return "dark";
                    }

                    // Default to light unless the user explicitly chose dark.
                    return "light";
                };

                const theme = getTheme();
                if (theme === "light") {
                    document.documentElement.setAttribute("data-theme", "light");
                } else {
                    document.documentElement.removeAttribute("data-theme");
                }
            })();
        </script>

        <title>{title}</title>
        <meta name="description" content={description} />
        {robotsDirectives ? <meta name="robots" content={robotsDirectives} /> : null}

        <link rel="canonical" href={canonicalUrl} />
        {alternates.map((alternate) => (
            <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
        ))}

        <link rel="icon" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preload" as="image" type="image/webp"
              imagesrcset="/hero-bg-light-sm-padded.webp 768w,
                           /hero-bg-light-md.webp 1280w,
                           /hero-bg-light-lg.webp 1920w"
              imagesizes="100vw" />

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE_BRAND} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta property="og:url" content={canonicalUrl} />
        {runtimeOgLocale && <meta property="og:locale" content={OPEN_GRAPH_LOCALES[runtimeOgLocale]} />}
        {runtimeOgLocale &&
            shouldEmitOgLocaleAlternates &&
            runtimeAlternateLocales
                .filter((alternate) => alternate.locale !== locale)
                .map((alternate) => (
                    <meta property="og:locale:alternate" content={OPEN_GRAPH_LOCALES[alternate.locale]} />
                ))}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@DuetMailApp" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        {extraHeadHtml ? <Fragment set:html={extraHeadHtml} /> : null}
    </head>
    <body>
        <Fragment set:html={gtmNoscriptHtml} />
        <slot />

        <!--
          Cookie consent banner (SC-1, landing leg). English copy lives in the
          snippet (mirrors the app ConsentBanner EXACTLY); brand + privacy href are
          interpolated here from the build env (B3). Founder copy sign-off pending
          before any locale fan-out — English only, no translation.
        -->
        <Fragment set:html={consentBannerRendered} />
    </body>
</html>
