---
import LanguageMenu from "../nav/LanguageMenu.astro";
import { DEFAULT_LOCALE, type Locale } from "../../i18n/locales";
import { localizedPath, type AlternateLink } from "../../i18n/routing";
import { t, type Messages } from "../../i18n/messages/schema";

type FooterLink = {
    id: string;
    labelKey: string;
    href: string;
    external?: boolean;
};

type FooterGroup = {
    id: string;
    titleKey: string;
    links: FooterLink[];
};

type Props = {
    locale: Locale;
    messages: Messages;
    alternates: AlternateLink[];
};

const { locale, messages, alternates } = Astro.props;
const year = new Date().getFullYear();
const homePath = localizedPath(locale, { kind: "home" });
const anchor = (id: string) => `${homePath}#${id}`;

const groups: FooterGroup[] = [
    {
        id: "explore",
        titleKey: "footer.explore",
        links: [
            { id: "organization", labelKey: "nav.organization", href: anchor("organization") },
            { id: "drafting", labelKey: "nav.drafting", href: anchor("drafting") },
            { id: "intelligence", labelKey: "nav.intelligence", href: anchor("intelligence") },
            {
                id: "chrome-extension",
                labelKey: "footer.chromeExtension",
                href: "https://chromewebstore.google.com/detail/aiigdjghdodkbipkkcjacnhednmlhemo?utm_source=chiefy-landing",
                external: true,
            },
        ],
    },
    {
        id: "customers",
        titleKey: "footer.customers",
        links: [
            { id: "pricing", labelKey: "nav.pricing", href: anchor("pricing") },
            { id: "testimonials", labelKey: "nav.testimonials", href: anchor("testimonials") },
            { id: "faq", labelKey: "nav.faq", href: anchor("faq") },
            // Help is English-only (no locale-prefixed help pages are generated),
            // so always point at the EN help index — a localized href would 404.
            { id: "help", labelKey: "help.nav.label", href: localizedPath(DEFAULT_LOCALE, { kind: "helpIndex" }) },
        ],
    },
    {
        id: "legal",
        titleKey: "footer.legal",
        links: [
            { id: "privacy", labelKey: "legalNav.privacy", href: localizedPath(locale, { kind: "legal", page: "privacy" }) },
            { id: "terms", labelKey: "legalNav.terms", href: localizedPath(locale, { kind: "legal", page: "terms" }) },
            { id: "cookies", labelKey: "legalNav.cookies", href: localizedPath(locale, { kind: "legal", page: "cookies" }) },
            { id: "disclaimer", labelKey: "legalNav.disclaimer", href: localizedPath(locale, { kind: "legal", page: "disclaimer" }) },
        ],
    },
    {
        id: "connect",
        titleKey: "footer.connect",
        links: [
            { id: "blog", labelKey: "nav.blog", href: localizedPath(locale, { kind: "blogIndex" }) },
            { id: "contact", labelKey: "footer.contact", href: "mailto:hello@chiefy.com" },
        ],
    },
];
---

<footer aria-label={t(messages, "site.footerAria")} class="site-footer">
    <div class="mx-auto max-w-6xl px-6 py-20 md:px-10">
        <div class="flex flex-col gap-14 lg:flex-row lg:gap-10">
            <div class="footer-brand">
                <a href={homePath} class="flex items-center gap-2">
                    <img
                        src="/logo-white.png"
                        width="96"
                        height="33"
                        class="h-[27px] w-auto logo-dark"
                        alt="Chiefy"
                        decoding="async"
                    />
                    <img
                        src="/logo-combined.png"
                        width="96"
                        height="27"
                        class="h-[27px] w-auto logo-light"
                        alt="Chiefy"
                        decoding="async"
                    />
                </a>

                <p class="footer-tagline mt-5 mb-0 max-w-sm text-pretty">
                    {t(messages, "footer.tagline")}
                </p>

                <LanguageMenu
                    locale={locale}
                    messages={messages}
                    alternates={alternates}
                    className="footer-language-menu"
                />

                <p class="footer-copyright mt-10 mb-0">
                    {t(messages, "footer.copyright", { year })}
                </p>
            </div>

            <div
                class="grid flex-1 grid-cols-2 gap-x-10 gap-y-12 sm:grid-cols-4"
            >
                {
                    groups.map((group) => (
                        <nav
                            aria-labelledby={`footer-${group.id}`}
                        >
                            <h2
                                id={`footer-${group.id}`}
                                class="footer-heading m-0"
                            >
                                {t(messages, group.titleKey)}
                            </h2>

                            <ul class="mt-5 flex flex-col gap-3" role="list">
                                {group.links.map((link) => (
                                    <li>
                                        <a
                                            class="footer-link"
                                            href={link.href}
                                            data-cta={link.id === "chrome-extension" ? "ext_redirect" : undefined}
                                            target={
                                                link.external
                                                    ? "_blank"
                                                    : undefined
                                            }
                                            rel={
                                                link.external
                                                    ? "noopener noreferrer"
                                                    : undefined
                                            }
                                        >
                                            {t(messages, link.labelKey)}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    ))
                }
            </div>
        </div>
    </div>
</footer>

<script is:inline>
    // Analytics only (SC-5): push the canonical ext_redirect_click dataLayer event
    // when the user clicks the Chrome Web Store extension link. The downstream GTM
    // tag is consent-gated per WS-C, so this push is unconditional. Tiny, deferred,
    // never blocks navigation.
    (function () {
        if (typeof window === "undefined" || typeof document === "undefined") return;
        var links = document.querySelectorAll('a[data-cta="ext_redirect"]');
        if (!links.length) return;
        links.forEach(function (link) {
            link.addEventListener("click", function () {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({ event: "ext_redirect_click" });
            });
        });
    })();
</script>

<style>
    .site-footer {
        background: var(--duet-bg);
    }

    .logo-light {
        display: none;
    }

    :global(html[data-theme="light"]) .logo-dark {
        display: none;
    }

    :global(html[data-theme="light"]) .logo-light {
        display: block;
    }

    .footer-brand {
        flex: none;
    }

    @media (min-width: 1024px) {
        .footer-brand {
            width: 354px;
        }
    }

    .footer-tagline {
        font-size: 14px;
        font-weight: 500;
        line-height: 1.5;
        letter-spacing: -0.01em;
        color: var(--prose-text);
    }

    .footer-copyright {
        font-size: 14px;
        line-height: 1.4;
        color: var(--duet-muted);
    }

    .footer-heading {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--prose-heading);
    }

    .footer-link {
        display: inline-flex;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--duet-muted);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .footer-link:hover {
        color: var(--prose-heading);
    }

    .footer-link:focus-visible {
        outline: none;
        border-radius: 8px;
        box-shadow: 0 0 0 2px var(--duet-accent);
    }
</style>
