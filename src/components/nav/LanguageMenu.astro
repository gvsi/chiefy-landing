---
import { LOCALE_ENDONYMS, isRuntimeLocale, type Locale } from "../../i18n/locales"
import type { AlternateLink } from "../../i18n/routing"
import { t, type Messages } from "../../i18n/messages/schema"

type Props = {
    locale: Locale
    messages: Messages
    alternates: AlternateLink[]
    className?: string
}

const { locale, messages, alternates, className } = Astro.props

const localeAlternates = alternates
    .filter((alternate): alternate is { locale: Locale; href: string } =>
        alternate.locale !== "x-default" && isRuntimeLocale(alternate.locale),
    )
    .filter(
        (alternate, index, list) =>
            list.findIndex((candidate) => candidate.locale === alternate.locale) === index,
    )

const shouldRender = localeAlternates.length >= 2
const currentLanguage = LOCALE_ENDONYMS[locale]

function originRelativeHref(href: string): string {
    try {
        const url = new URL(href)
        return `${url.pathname}${url.search}${url.hash}` || "/"
    } catch {
        return href
    }
}
---

{
    shouldRender ? (
        <details class:list={["language-menu", className]}>
            <summary
                class="language-menu-trigger"
                aria-label={t(messages, "language.current", { language: currentLanguage })}
            >
                <span class="language-menu-label">{t(messages, "language.label")}</span>
                <span class="language-menu-current" lang={locale}>{currentLanguage}</span>
                <svg
                    class="language-menu-chevron"
                    width="14"
                    height="14"
                    viewBox="0 0 14 14"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M3.5 5.25L7 8.75L10.5 5.25"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
            </summary>

            <div class="language-menu-panel">
                {localeAlternates.map((alternate) => {
                    const language = LOCALE_ENDONYMS[alternate.locale]
                    return (
                        <a
                            class:list={[
                                "language-menu-link",
                                alternate.locale === locale && "language-menu-link--current",
                            ]}
                            href={originRelativeHref(alternate.href)}
                            lang={alternate.locale}
                            aria-current={alternate.locale === locale ? "page" : undefined}
                            aria-label={t(messages, "language.switchTo", { language })}
                        >
                            {language}
                        </a>
                    )
                })}
            </div>
        </details>
    ) : null
}

<style>
    .language-menu {
        position: relative;
        flex-shrink: 0;
    }

    .language-menu > summary {
        list-style: none;
    }

    .language-menu > summary::-webkit-details-marker {
        display: none;
    }

    .language-menu-trigger {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        gap: 7px;
        border: 1px solid transparent;
        border-radius: 9999px;
        padding: 8px 10px;
        color: var(--nav-text);
        cursor: pointer;
        user-select: none;
        transition:
            color 0.2s ease,
            background 0.2s ease,
            border-color 0.2s ease;
    }

    .language-menu-trigger:hover {
        color: var(--nav-text-hover);
        background: rgba(255, 255, 255, 0.06);
    }

    :global(html[data-theme="light"]) .language-menu-trigger:hover {
        background: rgba(0, 0, 0, 0.05);
    }

    .language-menu-trigger:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.22);
    }

    :global(html[data-theme="light"]) .language-menu-trigger:focus-visible {
        box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.15);
    }

    .language-menu-label {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0;
    }

    .language-menu-current {
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0;
        color: var(--duet-muted);
    }

    .language-menu-chevron {
        transition: transform 0.16s ease;
    }

    .language-menu[open] .language-menu-chevron {
        transform: rotate(180deg);
    }

    .language-menu-panel {
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        z-index: 70;
        display: grid;
        min-width: 190px;
        max-height: min(360px, calc(100vh - 96px));
        overflow-y: auto;
        padding: 6px;
        border: 1px solid var(--nav-border);
        border-radius: 12px;
        background: var(--nav-mobile-bg);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.24);
    }

    .language-menu-link {
        display: flex;
        min-height: 40px;
        align-items: center;
        border-radius: 9px;
        padding: 8px 10px;
        color: var(--nav-text);
        font-size: 14px;
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: 0;
        text-decoration: none;
    }

    .language-menu-link:hover,
    .language-menu-link--current {
        color: var(--nav-text-hover);
        background: rgba(255, 255, 255, 0.06);
    }

    :global(html[data-theme="light"]) .language-menu-link:hover,
    :global(html[data-theme="light"]) .language-menu-link--current {
        background: rgba(0, 0, 0, 0.05);
    }

    .language-menu-link:focus-visible {
        outline: 2px solid var(--duet-accent);
        outline-offset: 2px;
    }

    :global(.footer-language-menu.language-menu) {
        width: fit-content;
        max-width: 100%;
        margin-top: 18px;
    }

    :global(.footer-language-menu.language-menu) .language-menu-trigger {
        min-height: 38px;
        padding: 8px 12px;
        border-color: var(--nav-border);
        color: var(--duet-muted);
    }

    :global(.footer-language-menu.language-menu) .language-menu-trigger:hover {
        color: var(--prose-heading);
    }

    :global(.footer-language-menu.language-menu) .language-menu-panel {
        right: auto;
        left: 0;
        top: auto;
        bottom: calc(100% + 8px);
        max-height: min(360px, calc(100vh - 96px));
    }
</style>
