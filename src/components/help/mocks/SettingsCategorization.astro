---
/**
 * SettingsCategorization — SCREEN 2: the Chiefy web-app "Categorization" page
 * (SystemCategorySettings.tsx + the 8 system categories from system_categories.py).
 * Standalone full-page settings mock.
 *
 *   - header H1 "Categorization" + green ● Enabled pill + a quiet ⚙ Settings
 *     button on the right with the master-toggle dropdown shown OPEN,
 *   - the Gmail instruction paragraph,
 *   - one card per category (8 total) in the exact order / colors / copy from the
 *     backend, with the monochrome keep-in-inbox toggle on the right. Promotions
 *     is the only one defaulting OFF (auto-archive, no "In Inbox" pill).
 *
 * Category chip colors are brand-fixed (theme-independent) — they mirror the
 * backend gmail_label color choices. Ink (white/dark) chosen for contrast.
 *
 *   <SettingsCategorization />
 */
import MockScreen from "./MockScreen.astro"
import MockIcon from "./MockIcon.astro"

type Cat = {
    name: string
    bg: string
    ink: string
    desc: string
    on: boolean
}

// Exact order, names, hex chip colors, descriptions, default state.
const CATEGORIES: Cat[] = [
    { name: "Action needed", bg: "#EF4444", ink: "#fff", desc: "Someone is waiting for you to respond or take action", on: true },
    { name: "Awaiting reply", bg: "#F97316", ink: "#1a1205", desc: "You're waiting for a response to your question or request", on: true },
    { name: "Comment", bg: "#FACC15", ink: "#3a2e05", desc: "Notifications about comments and activity on shared content", on: true },
    { name: "FYI", bg: "#10B981", ink: "#062b1d", desc: "Information shared with you - no response needed", on: true },
    { name: "Meeting update", bg: "#06B6D4", ink: "#fff", desc: "Calendar invites, updates, and meeting materials", on: true },
    { name: "Notification", bg: "#3B82F6", ink: "#fff", desc: "Automated alerts about events, status, or transactions", on: true },
    { name: "Promotions", bg: "#A855F7", ink: "#fff", desc: "Newsletters, marketing emails, and promotional content", on: false },
    { name: "Resolved", bg: "#EC4899", ink: "#3a0820", desc: "Completed conversations and resolved matters", on: true },
]
---

<MockScreen
    title="Chiefy · Categorization"
    figcaption="Categorization sorts every email into a label. Toggle which categories stay in your inbox; the rest are organized out of sight."
>
    <div class="hms-screen">
        <div class="hms-screen-inner">
            <div class="hms-head">
                <div class="hms-head-row">
                    <h1 class="hms-h1">Categorization</h1>
                    <span class="hms-status ok">
                        <span class="dot"></span>
                        Enabled
                    </span>
                    <span class="hms-head-spacer"></span>
                    <div class="hms-anchor">
                        <button class="hms-quiet-btn" type="button" aria-expanded="true">
                            <MockIcon name="settings" size={15} />
                            Settings
                        </button>
                        {/* master-toggle dropdown shown open */}
                        <div class="hms-pop w288 hms-pop-anchored right-0 below" role="menu">
                            <div class="hms-pop-row">
                                <span class="lab"><b>Enable categorization</b></span>
                                <span class="hms-toggle" role="img" aria-label="Categorization: On"></span>
                            </div>
                            <p class="hms-pop-help">
                                Turn off to stop automatic sorting. Your category preferences will stay
                                here until you turn it back on.
                            </p>
                        </div>
                    </div>
                </div>
                <p class="hms-sub">
                    Every email is automatically sorted into categories. Choose which ones you want to
                    see in your inbox—the rest will be organized into labels without cluttering your view.
                </p>
            </div>

            <div class="hms-stack">
                {
                    CATEGORIES.map((c) => (
                        <div class="hms-card hms-cat-row">
                            <div class="hms-cat-left">
                                <div class="hms-cat-chiprow">
                                    <span class="hms-cat-chip" style={`background:${c.bg};color:${c.ink}`}>
                                        {c.name}
                                    </span>
                                    {c.on && <span class="hms-inbox-pill">In Inbox</span>}
                                </div>
                                <p class="hms-cat-desc">{c.desc}</p>
                            </div>
                            <div class="hms-cat-toggle-wrap">
                                <span
                                    class={`hms-toggle${c.on ? "" : " off"}`}
                                    role="img"
                                    aria-label={`Keep ${c.name} in inbox: ${c.on ? "On" : "Off"}`}
                                />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</MockScreen>
