---
/**
 * OnboardingExtensionsToggle — Chrome's native extensions manager
 * (chrome://extensions) showing the Chiefy extension card with its Material
 * toggle ON. Chrome's own neutral palette (fixed, theme-independent) — the
 * focal point is "make sure the toggle is on". A faint second OFF card is shown
 * for on/off contrast.
 *
 * The gem app icon is the only brand mark. Version + name match the live
 * extension. Static / zero-JS.
 *
 *   <OnboardingExtensionsToggle />
 */
import MockScreen from "./MockScreen.astro"
import ChiefyGem from "./ChiefyGem.astro"
---

<MockScreen
    title="Chrome · Extensions — chrome://extensions"
    bodyClass="hms-chrome"
    figcaption="Make sure the Chiefy toggle is switched on in chrome://extensions."
>
    <div class="hms-chrome">
        <div class="hms-ext-head">
            <span class="t">Extensions</span>
            <span class="hms-ext-devmode">
                Developer mode
                <span class="hms-mat-toggle off" role="img" aria-label="Developer mode: off"></span>
            </span>
        </div>

        <div class="hms-ext-body">
            {/* ON card — the focal point */}
            <div class="hms-ext-card">
                <div class="hms-ext-card-top">
                    <span class="hms-ext-ico"><ChiefyGem size={36} title="Chiefy" /></span>
                    <div class="hms-ext-info">
                        <div class="hms-ext-name">Chiefy - AI Email Assistant</div>
                        <p class="hms-ext-desc">AI email assistant for Gmail and Outlook…</p>
                        <p class="hms-ext-ver">2.7.5</p>
                    </div>
                </div>
                <div class="hms-ext-card-foot">
                    <span class="hms-ext-link">Details</span>
                    <span class="hms-ext-link">Remove</span>
                    <span class="hms-ext-foot-spacer"></span>
                    <span class="hms-anchor" style="display:inline-flex;align-items:center">
                        <span class="help-anno" aria-hidden="true" style="margin-right:8px">A</span>
                        <span class="hms-mat-toggle" role="img" aria-label="Chiefy enabled: on"></span>
                    </span>
                </div>
            </div>

            {/* OFF card for contrast */}
            <div class="hms-ext-card muted">
                <div class="hms-ext-card-top">
                    <span class="hms-ext-ico" style="opacity:.55"><ChiefyGem size={36} /></span>
                    <div class="hms-ext-info">
                        <div class="hms-ext-name">Chiefy - AI Email Assistant</div>
                        <p class="hms-ext-desc">Off — Chiefy won't run in Gmail until you switch it on.</p>
                    </div>
                </div>
                <div class="hms-ext-card-foot">
                    <span class="hms-ext-link">Details</span>
                    <span class="hms-ext-link">Remove</span>
                    <span class="hms-ext-foot-spacer"></span>
                    <span class="hms-mat-toggle off" role="img" aria-label="Chiefy enabled: off"></span>
                </div>
            </div>
        </div>
    </div>
</MockScreen>
