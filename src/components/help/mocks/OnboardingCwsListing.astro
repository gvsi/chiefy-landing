---
/**
 * OnboardingCwsListing — the Chrome Web Store detail page for the Chiefy
 * extension (CWS_LISTING.md copy). Chrome is its own visual world, so this is
 * rendered in Chrome's fixed neutral palette (theme-independent) — NOT the
 * help-center tokens. The one brand exception is the gem app icon.
 *
 * Verbatim from CWS_LISTING.md:
 *   - title "Chiefy - AI Email Assistant"
 *   - short description (the 132-char line)
 *   - overview heading + the three value blocks (emojis kept — they're the real
 *     listing copy).
 * Rating/users are representative placeholders. Screenshot tiles nest tiny Gmail
 * inbox renders so the carousel reads real.
 *
 *   <OnboardingCwsListing />
 */
import MockScreen from "./MockScreen.astro"
import MockIcon from "./MockIcon.astro"
import ChiefyGem from "./ChiefyGem.astro"
import ProviderLogo from "./ProviderLogo.astro"
---

<MockScreen
    title="Chrome Web Store · chromewebstore.google.com"
    bodyClass="hms-chrome"
    figcaption="Install Chiefy from the Chrome Web Store — one click to add it to Chrome."
>
    <div class="hms-chrome">
        <div class="hms-cws-topbar">
            <ProviderLogo name="chrome-store" size={22} />
            <span class="hms-cws-wordmark">chrome web store</span>
            <span class="hms-cws-search">
                <MockIcon name="search" size={16} />
                Search extensions
            </span>
        </div>

        <div class="hms-cws-body">
            <div class="hms-cws-header">
                <span class="hms-cws-icon"><ChiefyGem size={52} title="Chiefy" /></span>
                <div>
                    <h1 class="hms-cws-title">Chiefy - AI Email Assistant</h1>
                    <div class="hms-cws-meta">
                        <span>chiefy.com</span>
                        <span>·</span>
                        <span class="hms-cws-rating">
                            <span class="stars" aria-hidden="true">
                                <MockIcon name="star" size={14} />
                                <MockIcon name="star" size={14} />
                                <MockIcon name="star" size={14} />
                                <MockIcon name="star" size={14} />
                                <MockIcon name="star" size={14} />
                            </span>
                            4.8 (123)
                        </span>
                        <span>·</span>
                        <span>10,000+ users</span>
                        <span>·</span>
                        <span>Communication</span>
                    </div>
                    <button class="hms-cws-add" type="button">Add to Chrome</button>
                </div>
            </div>

            <p class="hms-cws-shortdesc">
                AI email assistant for Gmail and Outlook: auto-drafts replies, organizes your inbox,
                and saves 4+ hours/week.
            </p>

            <div class="hms-cws-shots" aria-hidden="true">
                <div class="hms-cws-shot">
                    <div class="hms-shot-mini">
                        <div class="r">
                            <span class="av" style="background:#137333"></span>
                            <b>Bayview Cottages</b>
                            <span class="chip" style="background:#fce8e6;color:#c5221f;margin-left:auto">Action</span>
                        </div>
                        <div class="r">
                            <span class="av" style="background:#4338ca"></span>
                            <span>Jordan Lee</span>
                            <span class="chip" style="background:#fef7e0;color:#b06000;margin-left:auto">FYI</span>
                        </div>
                        <div class="r">
                            <span class="av" style="background:#635bff"></span>
                            <span>Stripe</span>
                            <span style="margin-left:auto;color:#5f6368">7:30</span>
                        </div>
                    </div>
                </div>
                <div class="hms-cws-shot">Screenshot</div>
                <div class="hms-cws-shot">Screenshot</div>
            </div>

            <h2 class="hms-cws-section-h">Overview</h2>
            <p class="hms-cws-overview-h">WHY BUSY PROFESSIONALS SWITCH TO CHIEFY</p>
            <div class="hms-cws-value">
                <b>🎯 Inbox Zero Without the Work</b>
                <span>AI categorizes every email automatically. Important → top. Promotional/newsletters → later. You'll never miss what matters again.</span>
            </div>
            <div class="hms-cws-value">
                <b>📝 Replies That Sound Like You (Not a Robot)</b>
                <span>Chiefy learns your writing style and drafts replies that match your tone. Edit if needed, hit send. Done.</span>
            </div>
            <div class="hms-cws-value">
                <b>💬 Ask Your Inbox Anything</b>
                <span>"What did Sarah say about the contract?" "Am I free Thursday at 2pm?" Chiefy searches your email and calendar instantly.</span>
            </div>
        </div>
    </div>
</MockScreen>
