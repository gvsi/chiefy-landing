---
/**
 * SettingsPrivacy — SCREEN 5: an HONEST composite of the real Chiefy privacy /
 * data controls (there is no dedicated privacy page in the app today). It stitches
 * the genuine, shipping affordances into one "Privacy & data" section:
 *   1. "Sent with Chiefy" footer toggle (AttributionSettings.tsx) — ON,
 *   2. Language preference (LanguagePreference.tsx) — a native-style select,
 *   3. Mailbox disconnect — the real "stop processing my data" control (kebab →
 *      red Disconnect), captioned to explain what disconnecting does,
 *   4. Logout (DropdownUser.tsx) — a quiet bordered button.
 *
 * Deliberately does NOT invent "Download my data" / "Delete account" / a
 * retention slider — those don't exist in the product (account deletion is via
 * support). Example data only.
 *
 *   <SettingsPrivacy />
 */
import MockScreen from "./MockScreen.astro"
import MockIcon from "./MockIcon.astro"
import ProviderLogo from "./ProviderLogo.astro"
---

<MockScreen
    title="Chiefy · Privacy & data"
    figcaption="The real privacy controls Chiefy ships today: the outgoing-mail footer, product language, mailbox disconnect, and sign-out."
>
    <div class="hms-screen">
        <div class="hms-screen-inner">
            <div class="hms-head">
                <div class="hms-head-row">
                    <h1 class="hms-h1">Privacy &amp; data</h1>
                </div>
                <p class="hms-sub">Control what Chiefy adds to your mail, the language it speaks, and access to your inbox.</p>
            </div>

            <div class="hms-stack">
                {/* 1 — Sent with Chiefy footer */}
                <div class="hms-card hms-card-row">
                    <div class="hms-cr-body">
                        <p class="hms-cr-title">Sent with Chiefy</p>
                        <p class="hms-cr-desc">Adds a small line at the end of drafts Chiefy writes for you.</p>
                    </div>
                    <span class="hms-toggle" role="img" aria-label="Sent with Chiefy footer: On"></span>
                </div>

                {/* 2 — Language */}
                <div class="hms-card hms-card-row">
                    <div class="hms-cr-body">
                        <p class="hms-cr-title">Language</p>
                        <p class="hms-cr-desc">
                            Controls Chiefy product text. Email drafts still follow the conversation language.
                        </p>
                    </div>
                    <span class="hms-select" role="img" aria-label="Language: Use browser language">
                        Use browser language
                        <MockIcon name="chevron-down" size={15} />
                    </span>
                </div>

                {/* 3 — Mailbox disconnect (real data control) */}
                <div class="hms-card">
                    <div class="hms-int-row">
                        <span class="hms-logo-tile"><ProviderLogo name="gmail" size={26} /></span>
                        <div class="hms-int-body">
                            <div class="hms-int-name-row">
                                <span class="hms-int-name">Bookings</span>
                                <span class="hms-status ok">
                                    <MockIcon name="check-circle" size={13} />
                                    Connected
                                </span>
                            </div>
                            <p class="hms-int-email">bookings@bayviewcottages.com</p>
                        </div>
                        <div class="hms-int-actions hms-anchor">
                            <button
                                class="hms-kebab"
                                type="button"
                                aria-label="More actions for bookings@bayviewcottages.com"
                                aria-expanded="true"
                            >
                                <MockIcon name="kebab" size={18} />
                            </button>
                            <div class="hms-pop hms-pop-anchored right-0 below" role="menu" style="min-width:160px">
                                <div class="hms-pop-item danger" role="menuitem">
                                    <MockIcon name="circle-off" size={15} />
                                    Disconnect
                                </div>
                            </div>
                        </div>
                    </div>
                    <p class="hms-int-cap" style="margin-top:12px">
                        Disconnecting pauses sync and stops Chiefy reading this mailbox. You can reconnect anytime.
                    </p>
                </div>

                {/* 4 — Logout */}
                <div class="hms-card hms-card-row">
                    <div class="hms-cr-body">
                        <p class="hms-cr-title">Sign out</p>
                        <p class="hms-cr-desc">End your session on this device.</p>
                    </div>
                    <button class="hms-logout-btn" type="button">
                        <MockIcon name="log-out" size={15} />
                        Logout
                    </button>
                </div>
            </div>
        </div>
    </div>
</MockScreen>
