    "credit-card": `<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>`,
    lock: `<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>`,
    "check-circle": `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/>`,
    check: `<path d="M20 6 9 17l-5-5"/>`,
    "mail-warning": `<path d="M22 10.5V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12"/><path d="m2 7 10 6 6-3.6"/><path d="M20 14v3"/><path d="M20 21h.01"/>`,
    "circle-off": `<path d="m2 2 20 20"/><path d="M8.35 2.69A10 10 0 0 1 21.3 15.65"/><path d="M19.08 19.08A10 10 0 1 1 4.92 4.92"/>`,
    plus: `<path d="M12 5v14M5 12h14"/>`,
    kebab: `<circle cx="12" cy="5" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="12" cy="19" r="1.4"/>`,
    "chevron-right": `<path d="m9 6 6 6-6 6"/>`,
    "chevron-down": `<path d="m6 9 6 6 6-6"/>`,
    "external-link": `<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>`,
    "alert-triangle": `<path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><path d="M12 9v4M12 17h.01"/>`,
