---
/**
 * MockIcon — lucide-style stroke icons (1.75px) for the settings + onboarding
 * mocks. Self-contained (does not depend on HelpIcon's category set) so the
 * cluster can ship the exact glyphs the real app uses without touching shared
 * components. Inherits `currentColor`; decorative (aria-hidden) by default.
 *
 *   <MockIcon name="settings" size={15} />
 */
type Props = {
    name: string
    size?: number
    stroke?: number
    class?: string
}

const { name, size = 16, stroke = 1.75, class: className } = Astro.props

const ICONS: Record<string, string> = {
