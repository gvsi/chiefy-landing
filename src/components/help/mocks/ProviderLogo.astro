---
/**
 * ProviderLogo — real, brand-accurate inline-SVG logos used across the settings
 * and onboarding mocks. These are fixed brand marks (NOT theme-tokenized): a
 * Gmail logo looks the same in both help-center themes.
 *
 * Keys:
 *   gmail            — multicolor Gmail envelope (the 5-path "M")
 *   gcal             — Google Calendar square
 *   outlook          — Outlook/Microsoft envelope-on-blue
 *   ms-squares       — Microsoft 4-square logo (sign-in button)
 *   google-g         — Google "G" (sign-in button)
 *   chrome-store     — Chrome Web Store colored wedge
 *
 *   <ProviderLogo name="gmail" size={28} />
 */
type Props = {
    name: "gmail" | "gcal" | "outlook" | "ms-squares" | "google-g" | "chrome-store"
    size?: number
    class?: string
}

const { name, size = 28, class: className } = Astro.props
---

{
    name === "gmail" && (
        <svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false" class={className}>
            <path fill="#fff" d="M6 13.5h36v25.5a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z" />
            <path fill="#4285f4" d="M42 13.5V38a2.5 2.5 0 0 1-2.5 2.5H35V21l-11 8.25z" />
            <path fill="#34a853" d="M6 13.5V38a2.5 2.5 0 0 0 2.5 2.5H13V21l11 8.25z" />
            <path fill="#fbbc04" d="M13 21V40.5H6V13.5z" />
            <path fill="#ea4335" d="M13 21 24 29.25 35 21v-7.5L24 21.75 13 13.5z" />
            <path fill="#c5221f" d="M6 13.5 13 13.5 13 21 6 16z" opacity="0" />
            <path fill="#c5221f" d="M42 13.5 35 13.5 35 21 42 16z" opacity="0" />
            <path fill="#ea4335" d="M6 13.5a2.5 2.5 0 0 1 4-2L24 21.75 38 11.5a2.5 2.5 0 0 1 4 2V21l-18 13.5L6 21z" opacity="0" />
        </svg>
    )
}
{
    name === "gcal" && (
        <svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false" class={className}>
            <path fill="#fff" d="M34 14H14v20h20z" />
            <path fill="#4285f4" d="M34 34 44 24V12a2 2 0 0 0-2-2H34z" />
            <path fill="#34a853" d="M34 34v10h8a2 2 0 0 0 2-2V34z" />
            <path fill="#ea4335" d="M4 34v6a4 4 0 0 0 4 4h6V34z" />
            <path fill="#fbbc04" d="M4 14v20h10V14z" />
            <path fill="#1967d2" d="M4 14h10V4H8a4 4 0 0 0-4 4z" />
            <path fill="#1a73e8" d="M14 4v10h20V4z" />
            <path fill="#188038" d="M34 4v10h10V8a4 4 0 0 0-4-4z" />
            <path
                fill="#4285f4"
                d="M18.2 28.6c-.6-.4-1-1-1.2-1.7l1.7-.7c.1.4.3.8.6 1 .3.3.7.4 1.1.4s.8-.1 1.1-.4q.45-.45.45-1.05c0-.5-.2-.8-.5-1.1q-.45-.45-1.2-.45h-1v-1.65h.9c.45 0 .8-.1 1.05-.35q.45-.45.45-.9c0-.3-.1-.55-.35-.75q-.3-.3-.75-.3c-.3 0-.55.1-.75.25-.2.2-.35.4-.45.65l-1.65-.7c.15-.5.5-.95 1-1.35.5-.35 1.15-.55 1.9-.55q.9 0 1.65.45c.5.3.85.65 1.15 1.15.25.45.4.95.4 1.55 0 .55-.15 1.05-.4 1.45-.25.35-.6.65-1 .85v.1c.5.2.95.55 1.25.95.35.45.5.95.5 1.6 0 .6-.15 1.15-.45 1.65-.3.45-.7.85-1.25 1.1q-.75.4-1.7.4c-.7 0-1.4-.2-2-.6Z"
