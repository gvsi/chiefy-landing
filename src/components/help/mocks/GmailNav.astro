---
/**
 * GmailNav — Gmail's faint left navigation rail (Compose pill + Inbox / Starred
 * / Snoozed / Sent / Drafts). Gmail palette, hardcoded. Used inside GmailFrame
 * for realism. A default <slot> appends extra nav content (e.g. a nested-labels
 * section via GmailNestedLabels).
 *
 *   <GmailNav inboxCount="12" draftsCount="2" />
 *   <GmailNav active="drafts">…labels slot…</GmailNav>
 */
import GmailIcon from "./GmailIcon.astro"
import GmailStyles from "./GmailStyles.astro"

type Props = {
    /** Which nav item is highlighted. */
    active?: "inbox" | "starred" | "snoozed" | "sent" | "drafts"
    inboxCount?: string
    draftsCount?: string
}

const { active = "inbox", inboxCount = "12", draftsCount } = Astro.props

const items = [
    { key: "inbox", label: "Inbox", icon: "inbox", count: inboxCount },
    { key: "starred", label: "Starred", icon: "star", count: undefined },
    { key: "snoozed", label: "Snoozed", icon: "clock", count: undefined },
    { key: "sent", label: "Sent", icon: "send", count: undefined },
    { key: "drafts", label: "Drafts", icon: "drafts", count: draftsCount },
] as const
---

<GmailStyles />
<nav class="gm-nav" aria-label="Mailboxes">
    <button class="gm-compose" type="button" tabindex="-1">
        <GmailIcon name="compose" size={20} />
        Compose
    </button>
    <div class="gm-navlist">
        {
            items.map((it) => (
                <span class={`gm-navitem${active === it.key ? " active" : ""}`} aria-current={active === it.key ? "page" : undefined}>
                    <GmailIcon name={it.icon} size={20} />
                    {it.label}
                    {it.count && <span class="gm-navcount">{it.count}</span>}
                </span>
            ))
        }
    </div>
    <slot />
</nav>
