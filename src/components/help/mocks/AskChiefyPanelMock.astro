---
/**
 * AskChiefyPanelMock — the "Ask Chiefy" chat surface (Figure B), a close-up of
 * the Chrome-extension side panel as injected into Gmail. The panel renders in
 * a Shadow DOM in the real extension and is NOT theme-aware, so it is a FIXED
 * light "screenshot" surface (slate-50 bg, white cards, gray-900 text, blue-600
 * accents) in BOTH help-center themes — only the outer figure frame adapts.
 *
 *   state="conversation" → header + a short conversation that exercises every
 *                          element: user bubble, the tool-trace rail, assistant
 *                          prose, and the composer with a context chip + usage
 *                          pill (send enabled).
 *   state="nux"          → the first-open empty state: Sparkles tile, title,
 *                          subtitle, suggestion chips, composer (send disabled).
 *
 * The Chiefy gem gradient is the only literal brand color; everything else is
 * the panel's own fixed palette. Static HTML/CSS, settled states (no JS).
 *
 * Replaces the Ask Chiefy chat figures in panel/chat help articles.
 */
import ChiefyGem from "./ChiefyGem.astro"

type Suggestion = { icon: string; iconClass: string; title: string; sub: string }
type Props = {
    state: "conversation" | "nux"
    figcaption?: string
    /** conversation: the user's message. */
    userMessage?: string
    userAvatar?: string
    /** conversation: assistant prose reply. */
    assistantReply?: string
    /** nux: suggestion chips. */
    suggestions?: Suggestion[]
}

// lucide-equivalent inner markup (24×24 viewBox), 2px stroke.
const ic: Record<string, string> = {
    history: `<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/>`,
    more: `<circle cx="12" cy="5" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="12" cy="19" r="1.4"/>`,
    x: `<path d="M18 6L6 18M6 6l12 12"/>`,
    sparkles: `<path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z"/><path d="M19 14l.8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8z"/>`,
    mailOpen: `<path d="M3 9l9-6 9 6"/><path d="M3 9v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9l-9 6z"/>`,
    search: `<circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/>`,
    filePen: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h7"/><path d="M14 2v6h6"/><path d="M17.5 14.5a2.1 2.1 0 0 1 3 3L16 22l-4 1 1-4z"/>`,
    mail: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/>`,
    bot: `<rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4M9 4h6"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/>`,
    mic: `<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>`,
    arrowUp: `<path d="M12 19V5M5 12l7-7 7 7"/>`,
    plus: `<path d="M12 5v14M5 12h14"/>`,
    inbox: `<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.4 5.1A2 2 0 0 1 7.2 4h9.6a2 2 0 0 1 1.8 1.1L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/>`,
    mailPlus: `<path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9"/><path d="M22 7l-10 5L2 7"/><path d="M19 16v6M16 19h6"/>`,
    calendarDays: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>`,
    calendarPlus: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"/>`,
}

const {
    state,
    figcaption,
    userMessage = "Draft a reply to Bayview about the early check-in question",
    userAvatar = "JL",
    assistantReply = "I read the booking thread and drafted a warm reply confirming a 1pm early check-in is fine at no extra charge. It's saved to your drafts — want me to send it?",
    suggestions = [
        { icon: "inbox", iconClass: "amber", title: "Summarize unread emails", sub: "Get a quick brief of new messages." },
        { icon: "mailPlus", iconClass: "emerald", title: "Create a new email draft", sub: "Start a fresh email; I'll help with wording." },
        { icon: "calendarDays", iconClass: "indigo", title: "What's on my calendar today", sub: "Review today's schedule and free slots." },
        { icon: "calendarPlus", iconClass: "purple", title: "Create a calendar event", sub: "Add an event with time, attendees, and details." },
    ],
} = Astro.props
---

<figure class="help-mock-figure ack-fig">
    <div class="ack-panel" role="group" aria-label="Ask Chiefy panel">
        {/* HEADER */}
        <div class="ack-header">
            <div class="ack-lockup">
                <ChiefyGem size={26} title="Chiefy" />
                <span class="ack-wordmark">Chiefy</span>
                <span class="ack-suffix">for Gmail</span>
            </div>
            <div class="ack-header-actions">
                <button class="ack-icon-btn" type="button" aria-label="Open history">
                    <svg width="18" height="18" viewBox="0 0 24 24" set:html={ic.history} />
                </button>
                <button class="ack-icon-btn" type="button" aria-label="More">
                    <svg width="18" height="18" viewBox="0 0 24 24" set:html={ic.more} />
                </button>
                <button class="ack-icon-btn" type="button" aria-label="Close panel">
                    <svg width="18" height="18" viewBox="0 0 24 24" set:html={ic.x} />
                </button>
            </div>
        </div>

        {/* BODY */}
        {
            state === "conversation" && (
                <div class="ack-body">
                    <div class="ack-msg-user">
                        <span class="ack-bubble">{userMessage}</span>
                        <span class="ack-user-av">{userAvatar}</span>
                    </div>

                    {/* Tool-trace rail — the distinctive "thinking" element */}
                    <div class="ack-trace" aria-label="Steps Chiefy took">
                        <span class="ack-rail" aria-hidden="true" />
                        <div class="ack-trace-row">
                            <span class="ack-marker">
                                <svg width="13" height="13" viewBox="0 0 24 24" set:html={ic.mailOpen} />
                            </span>
                            <span class="ack-trace-text">
                                <span class="ack-verb">Read this conversation</span>
                                <span class="ack-mid">·</span>
                                <span class="ack-detail">Re: Booking for the lakeside cabin</span>
                            </span>
                        </div>
                        <div class="ack-trace-row">
                            <span class="ack-marker">
                                <svg width="13" height="13" viewBox="0 0 24 24" set:html={ic.search} />
                            </span>
                            <span class="ack-trace-text">
                                <span class="ack-verb">Searched email</span>
                                <span class="ack-mid">·</span>
                                <span class="ack-detail">early check-in Bayview</span>
                                <span class="ack-mid">·</span>
                                <span class="ack-caption">3 results</span>
                            </span>
                        </div>
                        <div class="ack-trace-row">
                            <span class="ack-marker">
                                <svg width="13" height="13" viewBox="0 0 24 24" set:html={ic.filePen} />
                            </span>
                            <span class="ack-trace-text">
                                <span class="ack-verb">Saved a draft</span>
                            </span>
                        </div>
                    </div>

                    {/* Assistant prose (bare, no bubble) */}
                    <p class="ack-assistant">{assistantReply}</p>
                </div>
            )
        }

        {
            state === "nux" && (
                <div class="ack-body ack-body-nux">
                    <div class="ack-nux">
                        <span class="ack-nux-tile">
                            <svg width="24" height="24" viewBox="0 0 24 24" set:html={ic.sparkles} />
                        </span>
                        <h3 class="ack-nux-title">What can I help with?</h3>
                        <p class="ack-nux-sub">Choose a prompt to get started. You can refine or ask anything.</p>
                        <div class="ack-nux-list">
                            {suggestions.map((s) => (
                                <button class="ack-sugg" type="button">
                                    <span class={`ack-sugg-ic ${s.iconClass}`}>
                                        <svg width="18" height="18" viewBox="0 0 24 24" set:html={ic[s.icon]} />
                                    </span>
                                    <span class="ack-sugg-txt">
                                        <span class="ack-sugg-title">{s.title}</span>
                                        <span class="ack-sugg-sub">{s.sub}</span>
                                    </span>
                                </button>
                            ))}
                        </div>
                    </div>
                </div>
            )
        }

        {/* COMPOSER */}
        <div class="ack-composer">
            <div class="ack-composer-card">
                {
                    state === "conversation" && (
                        <div class="ack-ctx-row">
                            <span class="ack-ctx-chip">
                                <svg width="12" height="12" viewBox="0 0 24 24" set:html={ic.mail} />
                                Email
                            </span>
                            <span class="ack-usage">
                                <svg width="14" height="14" viewBox="0 0 24 24" set:html={ic.bot} />
                                <span class="ack-usage-n">37 left</span>
                                <span class="ack-usage-track" aria-hidden="true">
                                    <span class="ack-usage-fill" />
                                </span>
                            </span>
                        </div>
                    )
                }
                <div class="ack-textarea">
                    {
                        state === "conversation" ? (
                            <span class="ack-ph">Ask about this email, draft a reply, summarize…</span>
                        ) : (
                            <span class="ack-ph">Ask me anything…</span>
                        )
                    }
                </div>
                <div class="ack-controls">
                    <span class="ack-controls-left">
                        {
                            state === "conversation" && (
                                <button class="ack-newchat" type="button">
                                    <svg width="12" height="12" viewBox="0 0 24 24" set:html={ic.plus} />
                                    New chat
                                </button>
                            )
                        }
                    </span>
                    <span class="ack-controls-right">
                        <button class="ack-mic" type="button" aria-label="Voice dictation">
                            <svg width="16" height="16" viewBox="0 0 24 24" set:html={ic.mic} />
                        </button>
                        <button
                            class={`ack-send${state === "nux" ? " disabled" : ""}`}
                            type="button"
                            aria-label="Send"
                            aria-disabled={state === "nux" ? "true" : undefined}
                        >
                            <svg width="16" height="16" viewBox="0 0 24 24" set:html={ic.arrowUp} />
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>

    {figcaption && <figcaption class="help-figcap">{figcaption}</figcaption>}
</figure>

<style>
    /* ============================================================
       AskChiefyPanelMock — fixed-LIGHT "Shadow-DOM" screenshot surface.
       Theme-independent palette (identical in both help themes):
         panel bg #f8fafc · cards/bubbles #fff · text #111827
         secondary #6b7280 · muted #9ca3af · border #e5e7eb
         hairline #f1f5f9 · accent #2563eb (hover #1d4ed8) · tint #eff6ff
       Settled static states — no animation, no interactive transitions.
       ============================================================ */

    .ack-fig {
        /* figure frame (.help-mock-figure) is styled globally; this just
           centres the fixed-width panel within whatever frame wraps it. */
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* ---- Panel shell --------------------------------------------------- */
    .ack-panel {
        box-sizing: border-box;
        width: 100%;
        max-width: 400px;
        min-height: 560px;
        display: flex;
        flex-direction: column;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.06),
            0 18px 40px rgba(0, 0, 0, 0.12);
        overflow: hidden;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: #111827;
        text-align: left;
        -webkit-font-smoothing: antialiased;
    }

    /* ---- Header -------------------------------------------------------- */
    .ack-header {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        background: #ffffff;
        border-bottom: 1px solid #f1f5f9;
        flex: 0 0 auto;
    }

    .ack-lockup {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .ack-lockup :global(.chiefy-gem) {
        display: block;
        flex: 0 0 auto;
    }

    .ack-wordmark {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: #111827;
        line-height: 1;
    }

    .ack-suffix {
        font-size: 13px;
        font-weight: 400;
        color: #9ca3af;
        line-height: 1;
    }

    .ack-header-actions {
        display: flex;
        align-items: center;
        gap: 2px;
        flex: 0 0 auto;
    }

    .ack-icon-btn {
        box-sizing: border-box;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 8px;
        background: transparent;
        cursor: default;
    }

    .ack-icon-btn svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: #6b7280;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ---- Body (shared) ------------------------------------------------- */
    .ack-body {
        box-sizing: border-box;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 18px 16px;
        overflow: hidden;
    }

    /* ---- Conversation: user message ----------------------------------- */
    .ack-msg-user {
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        gap: 8px;
    }

    .ack-bubble {
        box-sizing: border-box;
        max-width: 80%;
        padding: 9px 13px;
        background: #eff6ff;
        color: #111827;
        font-size: 14px;
        line-height: 1.5;
        border-radius: 14px;
        border-top-right-radius: 5px;
    }

    .ack-user-av {
        box-sizing: border-box;
        flex: 0 0 auto;
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #2563eb;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        line-height: 1;
    }

    /* ---- Conversation: tool-trace rail -------------------------------- */
    .ack-trace {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding-left: 4px;
    }

    .ack-rail {
        position: absolute;
        top: 11px;
        bottom: 11px;
        left: 14px;
        width: 2px;
        background: #e5e7eb;
        border-radius: 1px;
    }

    .ack-trace-row {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding-left: 4px;
        z-index: 1;
    }

    .ack-marker {
        box-sizing: border-box;
        flex: 0 0 auto;
        width: 22px;
        height: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 50%;
        box-shadow: 0 0 0 3px #f8fafc;
    }

    .ack-marker svg {
        width: 13px;
        height: 13px;
        fill: none;
        stroke: #6b7280;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ack-trace-text {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 5px;
        padding-top: 2px;
        font-size: 13px;
        line-height: 1.45;
    }

    .ack-verb {
        color: #374151;
        font-weight: 500;
    }

    .ack-mid {
        color: #9ca3af;
    }

    .ack-detail {
        color: #6b7280;
    }

    .ack-caption {
        color: #9ca3af;
        font-size: 12px;
    }

    /* ---- Conversation: assistant prose -------------------------------- */
    .ack-assistant {
        margin: 0;
        color: #111827;
        font-size: 14.5px;
        line-height: 1.6;
    }

    /* ---- NUX empty state ---------------------------------------------- */
    .ack-body-nux {
        justify-content: center;
        align-items: center;
    }

    .ack-nux {
        box-sizing: border-box;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .ack-nux-tile {
        box-sizing: border-box;
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #4530ea 0%, #74c2ff 100%);
        margin-bottom: 4px;
    }

    .ack-nux-tile svg {
        width: 24px;
        height: 24px;
        fill: none;
        stroke: #ffffff;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ack-nux-title {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: #111827;
        text-align: center;
    }

    .ack-nux-sub {
        margin: 0 0 6px;
        font-size: 13.5px;
        line-height: 1.5;
        color: #6b7280;
        text-align: center;
        max-width: 280px;
    }

    .ack-nux-list {
        box-sizing: border-box;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .ack-sugg {
        box-sizing: border-box;
        width: 100%;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 12px;
        text-align: left;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        cursor: default;
    }

    .ack-sugg-ic {
        box-sizing: border-box;
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
    }

    .ack-sugg-ic svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Suggestion icon tints — tinted bg + inherited ink (currentColor). */
    .ack-sugg-ic.amber {
        background: #fef3c7;
        color: #d97706;
    }
    .ack-sugg-ic.emerald {
        background: #d1fae5;
        color: #059669;
    }
    .ack-sugg-ic.indigo {
        background: #e0e7ff;
        color: #4f46e5;
    }
    .ack-sugg-ic.purple {
        background: #f3e8ff;
        color: #9333ea;
    }

    .ack-sugg-txt {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .ack-sugg-title {
        font-size: 13.5px;
        font-weight: 500;
        color: #111827;
        line-height: 1.3;
    }

    .ack-sugg-sub {
        font-size: 12.5px;
        color: #6b7280;
        line-height: 1.35;
    }

    /* ---- Composer ------------------------------------------------------ */
    .ack-composer {
        box-sizing: border-box;
        flex: 0 0 auto;
        padding: 10px 12px 12px;
        background: #f8fafc;
    }

    .ack-composer-card {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 9px;
        padding: 10px 12px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    /* context + usage row (conversation only) */
    .ack-ctx-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .ack-ctx-chip {
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px 3px 7px;
        background: #f1f5f9;
        color: #374151;
        font-size: 12px;
        font-weight: 500;
        border-radius: 999px;
    }

    .ack-ctx-chip svg {
        width: 12px;
        height: 12px;
        fill: none;
        stroke: #6b7280;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ack-usage {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .ack-usage svg {
        width: 14px;
        height: 14px;
        fill: none;
        stroke: #9ca3af;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ack-usage-n {
        font-size: 12px;
        color: #6b7280;
        white-space: nowrap;
    }

    .ack-usage-track {
        box-sizing: border-box;
        display: inline-block;
        width: 48px;
        height: 5px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

    .ack-usage-fill {
        display: block;
        width: 60%;
        height: 100%;
        background: #2563eb;
        border-radius: 999px;
    }

    /* input area */
    .ack-textarea {
        box-sizing: border-box;
        min-height: 38px;
        display: flex;
        align-items: flex-start;
        padding: 2px 0;
    }

    .ack-ph {
        font-size: 14px;
        line-height: 1.45;
        color: #9ca3af;
    }

    /* controls row */
    .ack-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .ack-controls-left,
    .ack-controls-right {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .ack-newchat {
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px 5px 8px;
        background: transparent;
        border: 0;
        border-radius: 999px;
        color: #6b7280;
        font-size: 12.5px;
        font-weight: 500;
        cursor: default;
    }

    .ack-newchat svg {
        width: 12px;
        height: 12px;
        fill: none;
        stroke: #6b7280;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ack-mic {
        box-sizing: border-box;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: transparent;
        border: 0;
        border-radius: 8px;
        cursor: default;
    }

