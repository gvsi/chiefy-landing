---
/**
 * GmailNestedLabels — the "Labels" section of Gmail's left nav, showing how
 * Chiefy's system categories appear as NESTED Gmail labels: an expanded
 * "[Chiefy]" parent label with its category children (each with its own color
 * swatch), plus a generic user-label parent ("Bayview Cottages" → a child) to
 * reinforce the nesting pattern. Gmail palette, hardcoded.
 *
 *   <GmailNestedLabels />                       // full [Chiefy] tree (8 children)
 *   <GmailNestedLabels categories={["Action Needed","FYI","Promotions"]} />
 *
 * Designed to sit inside <GmailNav> (its default slot) or stand alone inside a
 * MockWindow as the nested-labels reference figure. `standalone` adds the
 * "Labels" subheader + a wrapping rail so it reads on its own.
 *
 * The 8 category colors match Chiefy's real Gmail label colors (system_categories).
 */
import GmailStyles from "./GmailStyles.astro"

type Cat = { name: string; color: string }

type Props = {
    /** Restrict to a subset of category child names (defaults to all 8). */
    categories?: string[]
    /** Render as a standalone figure (adds the "Labels" subheader + framing). */
    standalone?: boolean
    /** Include the generic user-label example ("Bayview Cottages" → child). */
    userExample?: boolean
}

// Chiefy system categories rendered as Gmail label colors (label swatch dots).
const ALL: Cat[] = [
    { name: "Action Needed", color: "#c5221f" },
    { name: "Awaiting Reply", color: "#e8710a" },
    { name: "Comment", color: "#f9ab00" },
    { name: "FYI", color: "#188038" },
    { name: "Meeting Update", color: "#129eaf" },
    { name: "Notification", color: "#1a73e8" },
    { name: "Promotions", color: "#8430ce" },
    { name: "Resolved", color: "#d01884" },
]

const { categories, standalone = false, userExample = true } = Astro.props
const children = categories ? ALL.filter((c) => categories.includes(c.name)) : ALL
---

<GmailStyles />
<div class={standalone ? "gm gm-labels-standalone" : ""} style={standalone ? undefined : "display:contents;"}>
    {standalone && <div class="gm-nav-labels-h" style="border:0;padding-top:0;">Labels</div>}
    <div class="gm-labels" role="tree" aria-label="Labels">
        {/* [Chiefy] parent — expanded */}
        <div class="gm-labelrow" role="treeitem" aria-expanded="true">
            <span class="gm-chev" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
            </span>
            <span class="gm-sw" style="background:#5f6368;" aria-hidden="true"></span>
            <span class="gm-lname">[Chiefy]</span>
        </div>
        {
            children.map((c) => (
                <div class="gm-labelrow child" role="treeitem">
                    <span class="gm-chev spacer" aria-hidden="true" />
                    <span class="gm-sw" style={`background:${c.color};`} aria-hidden="true" />
                    <span class="gm-lname">{c.name}</span>
                    <span class="gm-overflow" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="19" cy="12" r="1.7" /></svg>
                    </span>
                </div>
            ))
        }

        {
            userExample && (
                <>
                    <div class="gm-labelrow" role="treeitem" aria-expanded="true" style="margin-top:6px;">
                        <span class="gm-chev" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </span>
                        <span class="gm-sw" style="background:#137333;" aria-hidden="true" />
                        <span class="gm-lname">Bayview Cottages</span>
                    </div>
                    <div class="gm-labelrow child" role="treeitem">
                        <span class="gm-chev spacer" aria-hidden="true" />
                        <span class="gm-sw" style="background:#137333;" aria-hidden="true" />
                        <span class="gm-lname">Bayview Cottages/2026</span>
                    </div>
                </>
            )
        }
    </div>
</div>
