---
/**
 * SettingsIntegrations — SCREEN 3: the Chiefy web-app "Integrations" page
 * (IntegrationSettings.tsx + MailboxList.tsx), multi-mailbox / flag-ON IA.
 * Standalone full-page settings mock.
 *
 * Section 1 — Connected mailboxes:
 *   + Connect button with the provider CHOOSER popover shown open (Gmail / Outlook),
 *   three mailbox rows:
 *     A — Gmail, Jordan Lee, ✓ Connected, "Used to sign in" (no kebab),
 *     B — Gmail, Bookings, ✓ Connected, kebab OPEN showing red "Disconnect",
 *     C — Outlook, Alex Morgan, ⚠ Needs reconnecting, Reconnect button + kebab,
 *   plus a collapsed "▸ Disconnected (1)" group.
 * Section 2 — Integrations: a Google Calendar card in the NOT-connected state.
 *
 * Status chips pair an icon with text (never color alone). Example data only.
 *
 *   <SettingsIntegrations />
 */
import MockScreen from "./MockScreen.astro"
import MockIcon from "./MockIcon.astro"
import ProviderLogo from "./ProviderLogo.astro"
---

<MockScreen
    title="Chiefy · Integrations"
    figcaption="Connected mailboxes and integrations. Disconnect lives in the ⋯ menu; connect another mailbox or your calendar from here."
>
    <div class="hms-screen">
        <div class="hms-screen-inner">
            <div class="hms-head">
                <div class="hms-head-row">
                    <h1 class="hms-h1">Integrations</h1>
                </div>
                <p class="hms-sub">Manage your connected services and account permissions.</p>
            </div>

            {/* result banner */}
            <div class="hms-banner" style="margin-bottom:18px">
                <MockIcon name="info" size={17} class="lead" />
                <span>Mailbox connected — bookings@bayviewcottages.com connected.</span>
                <span class="x"><MockIcon name="x" size={15} /></span>
            </div>

            {/* SECTION 1 — Connected mailboxes */}
            <div class="hms-section-head">
                <h2 class="hms-h2">Connected mailboxes</h2>
                <span class="hms-head-spacer"></span>
                <div class="hms-anchor">
                    <button class="hms-btn-primary sm" type="button" aria-expanded="true">
                        <MockIcon name="plus" size={15} />
                        Connect mailbox
                    </button>
                    {/* provider chooser popover, open */}
                    <div class="hms-pop w240 hms-pop-anchored right-0 below" role="menu">
                        <div class="hms-pop-row" role="menuitem">
                            <span class="hms-pop-logo"><ProviderLogo name="gmail" size={20} /></span>
                            <span class="lab"><b>Gmail</b><span>Google account</span></span>
                        </div>
                        <div class="hms-pop-row" role="menuitem">
                            <span class="hms-pop-logo"><ProviderLogo name="outlook" size={20} /></span>
                            <span class="lab"><b>Outlook</b><span>Microsoft account</span></span>
                        </div>
                    </div>
                </div>
            </div>
            <p class="hms-section-helper">
                Mailboxes synced to this account. Connect another to manage them all in one place.
            </p>

            <div class="hms-stack">
                {/* Row A — sign-in mailbox, no kebab */}
                <div class="hms-card hms-int-row">
                    <span class="hms-logo-tile"><ProviderLogo name="gmail" size={26} /></span>
                    <div class="hms-int-body">
                        <div class="hms-int-name-row">
                            <span class="hms-int-name">Jordan Lee</span>
                            <span class="hms-status ok">
                                <MockIcon name="check-circle" size={13} />
                                Connected
                            </span>
                        </div>
                        <p class="hms-int-email">jordan@bayviewcottages.com</p>
                        <p class="hms-int-cap">Used to sign in</p>
                    </div>
                </div>

                {/* Row B — kebab open with Disconnect */}
                <div class="hms-card hms-int-row">
                    <span class="hms-logo-tile"><ProviderLogo name="gmail" size={26} /></span>
                    <div class="hms-int-body">
                        <div class="hms-int-name-row">
                            <span class="hms-int-name">Bookings</span>
                            <span class="hms-status ok">
                                <MockIcon name="check-circle" size={13} />
                                Connected
                            </span>
                        </div>
                        <p class="hms-int-email">bookings@bayviewcottages.com</p>
                    </div>
                    <div class="hms-int-actions hms-anchor">
                        <button
                            class="hms-kebab"
                            type="button"
                            aria-label="More actions for bookings@bayviewcottages.com"
                            aria-expanded="true"
                        >
                            <MockIcon name="kebab" size={18} />
                        </button>
                        <div class="hms-pop hms-pop-anchored right-0 below" role="menu" style="min-width:160px">
                            <div class="hms-pop-item danger" role="menuitem">
                                <MockIcon name="circle-off" size={15} />
                                Disconnect
                            </div>
                        </div>
                    </div>
                </div>

                {/* Row C — Outlook, needs reconnecting */}
                <div class="hms-card hms-int-row">
                    <span class="hms-logo-tile"><ProviderLogo name="outlook" size={26} /></span>
                    <div class="hms-int-body">
                        <div class="hms-int-name-row">
                            <span class="hms-int-name">Alex Morgan</span>
                            <span class="hms-status warn">
                                <MockIcon name="mail-warning" size={13} />
                                Needs reconnecting
                            </span>
                        </div>
                        <p class="hms-int-email">alex@bayviewcottages.com</p>
                    </div>
                    <div class="hms-int-actions">
                        <button class="hms-btn-primary sm" type="button">Reconnect</button>
                        <button
                            class="hms-kebab"
                            type="button"
                            aria-label="More actions for alex@bayviewcottages.com"
                        >
                            <MockIcon name="kebab" size={18} />
                        </button>
                    </div>
                </div>

                {/* collapsed disconnected group */}
                <button class="hms-collapse-toggle" type="button" aria-expanded="false">
                    <MockIcon name="chevron-right" size={15} />
                    Disconnected (1)
                </button>
            </div>

            {/* SECTION 2 — Integrations (Google Calendar) */}
            <div class="hms-section-head" style="margin-top:30px">
                <h2 class="hms-h2">Integrations</h2>
            </div>
            <div class="hms-card hms-int-row">
                <span class="hms-logo-tile"><ProviderLogo name="gcal" size={26} /></span>
                <div class="hms-int-body">
                    <div class="hms-int-name-row">
                        <span class="hms-int-name">Google Calendar</span>
                    </div>
                    <p class="hms-int-email">Used for finding availability and creating/updating events.</p>
                </div>
                <div class="hms-int-actions">
                    <button class="hms-btn-primary sm" type="button">
                        <MockIcon name="external-link" size={14} />
                        Connect
                    </button>
                </div>
            </div>
        </div>
    </div>
</MockScreen>
