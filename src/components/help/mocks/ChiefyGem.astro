---
/**
 * ChiefyGem — the Chiefy brand "gem" mark, inline SVG, EXACT from the design
 * system favicon (chiefy-design/project/assets/favicon.svg) and the extension's
 * ChiefyBrandMark.tsx. This is the ONLY surface in the whole mock cluster that
 * carries the brand gradient (#4530ea → #74c2ff).
 *
 *   <ChiefyGem size={24} />
 *
 * The gradient id is uniquely suffixed per-instance so multiple gems on one page
 * never collide (the path references a local <linearGradient>). Decorative by
 * default (aria-hidden); pass a `title` to give it an accessible name where the
 * mark is meaningful (e.g. a brand lockup the user must recognise).
 */
type Props = {
    /** Rendered square size in px. */
    size?: number
    /** Accessible name; when set the gem is exposed to AT instead of hidden. */
    title?: string
    class?: string
}

const { size = 24, title, class: className } = Astro.props

// Unique gradient id so stacked gems don't share/clobber each other's fill.
const gid = `chiefy-gem-${Math.random().toString(36).slice(2, 9)}`
---

<svg
    width={size}
    height={size}
    viewBox="14 14 72 63"
    fill="none"
    class={`chiefy-gem${className ? ` ${className}` : ""}`}
    role={title ? "img" : undefined}
    aria-label={title}
    aria-hidden={title ? undefined : "true"}
    focusable="false"
>
    {title && <title>{title}</title>}
    <defs>
        <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#4530ea"></stop>
            <stop offset="1" stop-color="#74c2ff"></stop>
        </linearGradient>
    </defs>
    <path
        d="M50 20 L80 72 H20 Z"
        fill={`url(#${gid})`}
        stroke={`url(#${gid})`}
        stroke-width="10"
        stroke-linejoin="round"></path>
    <path d="M50 20 L50 72 H20 Z" fill="#000000" fill-opacity="0.14"></path>
</svg>
