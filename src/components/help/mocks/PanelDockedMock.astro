---
/**
 * PanelDockedMock — Figure A: the Chiefy side panel docked to the RIGHT edge of
 * a Gmail inbox, showing WHERE it sits and the panel chrome (header + tabs).
 *
 * Left → right: a faint Gmail left nav (Compose + Inbox/Starred/…), the Gmail
 * message list (search bar + rows with label chips, one row selected, one
 * hovered), a slim Gmail right icon-rail with the Chiefy gem active, then the
 * 400px-wide Chiefy panel (slate-50, header lockup + Home / Ask Chiefy tabs +
 * a short NUX summary + composer).
 *
 * Gmail chrome = its own hardcoded palette (Roboto). The docked panel = a fixed
 * light "device screenshot" surface in both themes; only the figure frame adapts
 * via help-center tokens. Static HTML/CSS only.
 *
 * Replaces the "where the panel lives" figure in panel/getting-started articles.
 */
import ChiefyGem from "./ChiefyGem.astro"

type MailItem = {
    from: string
    subject: string
    snippet: string
    time: string
    unread?: boolean
    selected?: boolean
    hovered?: boolean
    chip?: { label: string; bg: string; ink: string }
    starred?: boolean
}
type Props = {
    figcaption?: string
    items?: MailItem[]
}

const navItems = [
    { label: "Inbox", key: "inbox", count: "12", active: true },
    { label: "Starred", key: "star" },
    { label: "Snoozed", key: "clock" },
    { label: "Sent", key: "send" },
    { label: "Drafts", key: "draft" },
]
const navIcon: Record<string, string> = {
    inbox: `<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.4 5.1A2 2 0 0 1 7.2 4h9.6a2 2 0 0 1 1.8 1.1L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/>`,
    star: `<path d="M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18.8 6.2 21l1.1-6.5L2.6 9.8l6.5-.9z"/>`,
    clock: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>`,
    send: `<path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/>`,
    draft: `<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>`,
}
const tabIcon = {
    home: `<path d="M3 11l9-8 9 8"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9"/>`,
    sparkles: `<path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z"/><path d="M19 14l.8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8z"/>`,
    plus: `<path d="M12 5v14M5 12h14"/>`,
    arrowUp: `<path d="M12 19V5M5 12l7-7 7 7"/>`,
    mailPlus: `<path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9"/><path d="M22 7l-10 5L2 7"/><path d="M19 16v6M16 19h6"/>`,
    inbox: `<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.4 5.1A2 2 0 0 1 7.2 4h9.6a2 2 0 0 1 1.8 1.1L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/>`,
}

const {
    figcaption,
    items = [
        {
            from: "Bayview Cottages",
            subject: "Re: Booking for the lakeside cabin — dates confirmed",
            snippet: "Hi — just confirming the booking for the last weekend…",
            time: "9:24 AM",
            unread: true,
            chip: { label: "Travel", bg: "#e6f4ea", ink: "#137333" },
            starred: true,
        },
        {
            from: "Jordan Lee",
            subject: "Q3 planning review — agenda + open questions",
            snippet: "Sharing the agenda ahead of Thursday so we can…",
            time: "8:10 AM",
            unread: true,
        },
        {
            from: "Stripe",
            subject: "Your payout of $2,480.00 is on the way",
            snippet: "A payout is on its way to your bank account…",
            time: "Yesterday",
            chip: { label: "Finance", bg: "#fce8e6", ink: "#c5221f" },
            selected: true,
        },
        {
            from: "Alex Morgan",
            subject: "Lunch Thursday? Picking a spot near the office",
            snippet: "There's a new place on 5th I've been meaning to…",
            time: "Yesterday",
            hovered: true,
        },
        {
            from: "Bayview Cottages",
            subject: "Guest question about early check-in",
            snippet: "A guest asked whether they can arrive before 2pm…",
            time: "Mon",
        },
    ],
} = Astro.props
---

<figure class="help-mock-figure pdock-fig">
    <div class="pdock">
        {/* GMAIL LEFT NAV */}
        <aside class="pdock-nav" aria-hidden="true">
            <span class="pdock-compose">
                <svg width="20" height="20" viewBox="0 0 24 24">
                    <path
                        d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"
                        stroke="#001d35"
                        stroke-width="1.7"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
                Compose
            </span>
            <ul class="pdock-nav-list">
                {navItems.map((n) => (
                    <li class={`pdock-nav-item${n.active ? " active" : ""}`}>
                        <svg width="18" height="18" viewBox="0 0 24 24" set:html={navIcon[n.key]} />
                        <span class="pdock-nav-lbl">{n.label}</span>
                        {n.count && <span class="pdock-nav-count">{n.count}</span>}
                    </li>
                ))}
            </ul>
        </aside>

        {/* GMAIL MESSAGE LIST */}
        <div class="pdock-list-col">
            <div class="pdock-search" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7" stroke="#5f6368" stroke-width="1.7" fill="none" />
                    <path d="M21 21l-4-4" stroke="#5f6368" stroke-width="1.7" stroke-linecap="round" />
                </svg>
                <span class="pdock-search-ph">Search mail</span>
            </div>
            <ul class="pdock-list">
                {items.map((m) => (
                    <li
                        class={`pdock-row${m.selected ? " sel" : ""}${m.hovered ? " hov" : ""}${m.unread ? " unread" : ""}`}
                    >
                        <span class="pdock-cb" aria-hidden="true" />
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            class={`pdock-star${m.starred ? " on" : ""}`}
                        >
                            <path
                                d="M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18.8 6.2 21l1.1-6.5L2.6 9.8l6.5-.9z"
                                fill={m.starred ? "#f9ab00" : "none"}
                                stroke={m.starred ? "#f9ab00" : "#5f6368"}
                                stroke-width="1.3"
                            />
                        </svg>
                        <span class="pdock-from">{m.from}</span>
                        <span class="pdock-body">
                            {m.chip && (
                                <span class="pdock-chip" style={`background:${m.chip.bg};color:${m.chip.ink}`}>
                                    {m.chip.label}
                                </span>
                            )}
                            <span class="pdock-subj">{m.subject}</span>
                            <span class="pdock-snip"> — {m.snippet}</span>
                        </span>
                        {m.hovered ? (
                            <span class="pdock-row-actions" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24">
                                    <rect x="3" y="5" width="18" height="4" rx="1" stroke="#5f6368" stroke-width="1.5" fill="none" />
                                    <path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M10 13h4" stroke="#5f6368" stroke-width="1.5" fill="none" stroke-linecap="round" />
                                </svg>
                                <svg width="16" height="16" viewBox="0 0 24 24">
                                    <path d="M3 6h18M8 6V4h8v2M6 6l1 14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-14" stroke="#5f6368" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <svg width="16" height="16" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="9" stroke="#5f6368" stroke-width="1.5" fill="none" />
                                    <path d="M12 7v5l3 2" stroke="#5f6368" stroke-width="1.5" fill="none" stroke-linecap="round" />
                                </svg>
                            </span>
                        ) : (
                            <span class="pdock-time">{m.time}</span>
                        )}
                    </li>
                ))}
            </ul>
        </div>

        {/* GMAIL RIGHT ICON-RAIL (add-on rail) */}
        <div class="pdock-rail" aria-hidden="true">
            <span class="pdock-rail-ic active">
                <ChiefyGem size={20} />
            </span>
            <span class="pdock-rail-dot" />
            <span class="pdock-rail-dot" />
        </div>

        {/* THE CHIEFY PANEL — docked right */}
        <div class="pdock-panel" role="group" aria-label="Chiefy panel">
            <div class="pdock-panel-head">
                <div class="pdock-lockup">
                    <ChiefyGem size={24} title="Chiefy" />
                    <span class="pdock-wordmark">Chiefy</span>
                    <span class="pdock-suffix">for Gmail</span>
                </div>
                <div class="pdock-head-actions">
                    <button class="pdock-icon-btn" type="button" aria-label="More">
                        <svg width="16" height="16" viewBox="0 0 24 24">
                            <circle cx="12" cy="5" r="1.4" /><circle cx="12" cy="12" r="1.4" /><circle cx="12" cy="19" r="1.4" />
                        </svg>
                    </button>
                    <button class="pdock-icon-btn" type="button" aria-label="Close panel">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="pdock-panel-body">
                <div class="pdock-nux">
                    <span class="pdock-nux-tile">
                        <svg width="22" height="22" viewBox="0 0 24 24" set:html={tabIcon.sparkles} />
                    </span>
                    <h3 class="pdock-nux-title">What can I help with?</h3>
                    <p class="pdock-nux-sub">Choose a prompt to get started.</p>
                    <div class="pdock-nux-list">
                        <button class="pdock-sugg" type="button">
                            <span class="pdock-sugg-ic amber">
                                <svg width="16" height="16" viewBox="0 0 24 24" set:html={tabIcon.inbox} />
                            </span>
                            <span class="pdock-sugg-title">Summarize unread emails</span>
                        </button>
                        <button class="pdock-sugg" type="button">
                            <span class="pdock-sugg-ic emerald">
                                <svg width="16" height="16" viewBox="0 0 24 24" set:html={tabIcon.mailPlus} />
                            </span>
                            <span class="pdock-sugg-title">Create a new email draft</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="pdock-composer">
                <div class="pdock-composer-card">
                    <span class="pdock-composer-ph">Ask me anything…</span>
                    <span class="pdock-send" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" set:html={tabIcon.arrowUp} />
                    </span>
                </div>
            </div>

            {/* TABS (free-user layout) at the panel bottom */}
            <div class="pdock-tabs">
                <button class="pdock-tab" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" set:html={tabIcon.home} />
                    Home
                </button>
                <button class="pdock-tab active" type="button">
                    <svg width="14" height="14" viewBox="0 0 24 24" set:html={tabIcon.sparkles} />
                    Ask Chiefy
                </button>
            </div>
        </div>
    </div>

    {figcaption && <figcaption class="help-figcap">{figcaption}</figcaption>}
</figure>

<style>
    /* =====================================================================
       PanelDockedMock — a static "product screenshot" composite.
       Left → right: faint Gmail left nav + Gmail message list + slim right
       icon-rail (all hardcoded to Gmail's real palette, Roboto) then the
       docked Chiefy panel (fixed light slate-50 surface, system-ui).
       Two distinct visual worlds, intentionally NOT theme-aware.
       Settled end-state only — no animation, no hover transitions.
       ===================================================================== */

    /* ---- outer composite -------------------------------------------- */
    .pdock {
        display: flex;
        align-items: stretch;
        width: 100%;
        max-width: 880px;
        height: 480px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.06),
            0 14px 32px rgba(0, 0, 0, 0.12);
        overflow: hidden;
    }
    .pdock *,
    .pdock *::before,
    .pdock *::after {
        box-sizing: border-box;
    }

    /* =====================================================================
       GMAIL LEFT NAV (Roboto, hardcoded Gmail palette)
       ===================================================================== */
    .pdock-nav {
        flex: none;
        width: 150px;
        background: #f6f8fc;
        padding: 10px 6px 14px;
        font-family: Roboto, Arial, "Helvetica Neue", sans-serif;
        color: #202124;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
    }
    .pdock-compose {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 40px;
        margin: 0 4px 14px;
        padding: 0 18px 0 12px;
        background: #c2e7ff;
        color: #001d35;
        border-radius: 14px;
        font-size: 13px;
        font-weight: 500;
        box-shadow:
            0 1px 3px rgba(60, 64, 67, 0.16),
            0 1px 1px rgba(60, 64, 67, 0.08);
        white-space: nowrap;
    }
    .pdock-compose svg {
        flex: none;
        width: 18px;
        height: 18px;
    }
    .pdock-nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }
    .pdock-nav-item {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 30px;
        padding: 0 12px 0 16px;
        border-radius: 0 14px 14px 0;
        color: #202124;
        font-size: 13px;
    }
    .pdock-nav-item svg {
        flex: none;
        width: 18px;
        height: 18px;
        fill: none;
        stroke: #5f6368;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .pdock-nav-lbl {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pdock-nav-count {
        margin-left: auto;
        font-size: 12px;
        color: #5f6368;
    }
    .pdock-nav-item.active {
        background: #d3e3fd;
        color: #0b57d0;
        font-weight: 700;
    }
    .pdock-nav-item.active svg {
        stroke: #0b57d0;
    }
    .pdock-nav-item.active .pdock-nav-count {
        color: #0b57d0;
    }

    /* =====================================================================
       GMAIL MESSAGE LIST (Roboto, hardcoded Gmail palette)
       ===================================================================== */
    .pdock-list-col {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        font-family: Roboto, Arial, "Helvetica Neue", sans-serif;
        color: #202124;
        -webkit-font-smoothing: antialiased;
    }
    .pdock-search {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 42px;
        margin: 10px 14px;
        padding: 0 14px;
        background: #f1f3f4;
        border-radius: 8px;
        flex: none;
    }
    .pdock-search svg {
        flex: none;
        width: 18px;
        height: 18px;
    }
    .pdock-search-ph {
        color: #5f6368;
        font-size: 13px;
    }
    .pdock-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }
    .pdock-row {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 44px;
        padding: 0 14px;
        background: #ffffff;
        border-bottom: 1px solid #f1f3f4;
    }
    .pdock-cb {
        flex: none;
        width: 16px;
        height: 16px;
        border: 2px solid #5f6368;
        border-radius: 2px;
        background: transparent;
    }
    .pdock-star {
        flex: none;
        width: 16px;
        height: 16px;
        display: block;
    }
    /* star svg carries inline fill/stroke; only ensure crisp size */
    .pdock-star path {
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .pdock-from {
        flex: none;
        width: 150px;
        color: #5f6368;
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pdock-body {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        overflow: hidden;
    }
    .pdock-chip {
        flex: none;
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 500;
        line-height: 1;
        padding: 3px 8px;
        border-radius: 4px;
        white-space: nowrap;
    }
    .pdock-subj {
        flex: none;
        max-width: 100%;
        color: #5f6368;
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pdock-snip {
        flex: 1;
        min-width: 0;
        color: #5f6368;
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pdock-time {
        flex: none;
        margin-left: 8px;
        font-size: 12px;
        color: #5f6368;
        white-space: nowrap;
    }
    .pdock-row-actions {
        flex: none;
        margin-left: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pdock-row-actions svg {
        flex: none;
        width: 16px;
        height: 16px;
    }

    /* row states — rendered as settled end-states */
    .pdock-row.unread {
        background: #ffffff;
        box-shadow: inset 3px 0 0 #0b57d0;
    }
    .pdock-row.unread .pdock-from,
    .pdock-row.unread .pdock-subj {
        color: #202124;
        font-weight: 700;
    }
    .pdock-row.unread .pdock-time {
        color: #202124;
        font-weight: 700;
    }
    .pdock-row.sel {
        background: #d3e3fd;
        border-bottom-color: #c6d9f5;
    }
    .pdock-row.sel .pdock-cb {
        border-color: #0b57d0;
        background: #0b57d0;
    }
    .pdock-row.hov {
        background: #f2f6fc;
        box-shadow:
            inset 1px 0 0 #e0e0e0,
            inset -1px 0 0 #e0e0e0,
            0 1px 2px rgba(60, 64, 67, 0.15);
        position: relative;
        z-index: 1;
    }

    /* =====================================================================
       GMAIL RIGHT ICON-RAIL (add-on rail, hardcoded Gmail palette)
       ===================================================================== */
    .pdock-rail {
        flex: none;
        width: 48px;
        background: #f6f8fc;
        border-left: 1px solid #e0e0e0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 14px 0;
    }
    .pdock-rail-ic {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
    }
    .pdock-rail-ic.active {
        background: #d3e3fd;
    }
    .pdock-rail-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #dadce0;
    }

    /* =====================================================================
       CHIEFY PANEL — docked right (fixed light slate surface, system-ui)
       ===================================================================== */
    .pdock-panel {
        flex: none;
        width: 360px;
        display: flex;
        flex-direction: column;
        background: #f8fafc;
        border-left: 1px solid #e5e7eb;
        color: #111827;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    /* ---- panel header ---- */
    .pdock-panel-head {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        height: 52px;
        padding: 0 14px;
        border-bottom: 1px solid #e5e7eb;
        background: #ffffff;
    }
    .pdock-lockup {
        display: flex;
        align-items: baseline;
        gap: 6px;
        min-width: 0;
    }
    .pdock-lockup :global(svg) {
        align-self: center;
        flex: none;
    }
    .pdock-wordmark {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.01em;
    }
    .pdock-suffix {
        font-size: 13px;
        color: #9ca3af;
    }
    .pdock-head-actions {
        display: flex;
        align-items: center;
        gap: 2px;
    }
    .pdock-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #6b7280;
        cursor: default;
    }
    .pdock-icon-btn svg {
        width: 16px;
        height: 16px;
    }
    /* the "more" dots are bare circles — fill them with the button color */
    .pdock-icon-btn svg circle {
        fill: currentColor;
        stroke: none;
    }

    /* ---- panel body / NUX ---- */
    .pdock-panel-body {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .pdock-nux {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px 22px;
    }
    .pdock-nux-tile {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(140deg, #dbeafe 0%, #ede9fe 100%);
        color: #2563eb;
        margin-bottom: 14px;
    }
    .pdock-nux-tile svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
