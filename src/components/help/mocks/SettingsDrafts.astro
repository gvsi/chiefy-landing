---
/**
 * SettingsDrafts — SCREEN 1: the Chiefy web-app "Drafts" settings page
 * (AutoDraftSettings.tsx). A standalone full-page settings mock (no settings
 * rail — Drafts is its own route opened from the side panel).
 *
 * Renders the single-mailbox layout (the common case):
 *   - header H1 "Drafts" + green ● Active pill,
 *   - Card A: Enable drafts (monochrome toggle ON),
 *   - Card B: "How often do you like to reply?" — 4 radio rows (3rd selected),
 *   - Card C: Email signature (Visual|HTML|Preview tabs + rendered signature).
 *
 * Replaces the placeholder Smart-Drafts SettingRow figure in turn-on-autodraft
 * and related Drafts articles. All example data is fictional (Jordan Lee /
 * Bayview Cottages).
 *
 *   <SettingsDrafts />
 */
import MockScreen from "./MockScreen.astro"
import SettingRowApp from "./SettingRowApp.astro"
import MockIcon from "./MockIcon.astro"

const REPLY_OPTIONS = [
    { label: "I reply to almost everything, even just to be polite", sel: false },
    { label: "I reply when there's something new or useful to say", sel: false },
    { label: "I reply if it feels expected, even without a clear question", sel: true },
    { label: "I only reply when there's a direct question or request", sel: false },
]
---

<MockScreen
    title="Chiefy · Drafts"
    figcaption="The Drafts settings: turn auto-drafting on, tune how often Chiefy replies, and set the signature it appends."
>
    <div class="hms-screen">
        <div class="hms-screen-inner">
            <div class="hms-head">
                <div class="hms-head-row">
                    <h1 class="hms-h1">Drafts</h1>
                    <span class="hms-status ok">
                        <span class="dot"></span>
                        Active
                    </span>
                </div>
                <p class="hms-sub">Manage how Chiefy automatically drafts replies.</p>
            </div>

            <div class="hms-stack">
                {/* Card A — Enable drafts */}
                <SettingRowApp
                    title="Enable drafts"
                    on
                    anno="A"
                    description="Chiefy will create reply drafts in Gmail for emails that need a response"
                />

                {/* Card B — reply frequency radios */}
                <div class="hms-card p6">
                    <p class="hms-section-title">How often do you like to reply?</p>
                    <div class="hms-stack sm">
                        {
                            REPLY_OPTIONS.map((o) => (
                                <label class={`hms-radio-row${o.sel ? " sel" : ""}`}>
                                    <span class="hms-radio" role="radio" aria-checked={o.sel ? "true" : "false"} />
                                    <span class="hms-radio-label">{o.label}</span>
                                </label>
                            ))
                        }
                    </div>
                </div>

                {/* Card C — signature editor */}
                <div class="hms-card p6">
                    <p class="hms-section-title">Email signature</p>
                    <p class="hms-cr-desc" style="margin-top:-8px">
                        This signature will be appended to all auto-drafted replies
                    </p>
                    <div class="hms-seg" role="tablist" aria-label="Signature editor mode">
                        <span class="active" role="tab" aria-selected="true">Visual</span>
                        <span role="tab" aria-selected="false">HTML</span>
                        <span role="tab" aria-selected="false">Preview</span>
                    </div>
                    <div class="hms-sig">
                        <b>Jordan Lee</b><br />
                        Bayview Cottages<br />
                        <span class="muted">jordan@bayviewcottages.com · +1 (250) 555-0142</span>
                    </div>
                    <div class="hms-sig-actions">
                        <button class="hms-btn-primary sm" type="button">
                            <MockIcon name="check" size={14} />
                            Save signature
                        </button>
                        <button class="hms-link-btn" type="button">Clear</button>
                        <button class="hms-link-btn" type="button">Use default</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</MockScreen>
