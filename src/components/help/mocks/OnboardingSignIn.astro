---
/**
 * OnboardingSignIn — the Chiefy /auth sign-in / "choose a provider" screen
 * (AuthPage.tsx + AuthLeftPane.tsx). Split layout, tokenized so it is correct in
 * BOTH help-center themes; the LEFT brand pane is always dark (the real pane is).
 *
 *   - LEFT: the "Whispered Luxury" brand pane — gem + "Chiefy" lockup + a
 *     one-line product positioning; ambient glows.
 *   - RIGHT: the default SIGN-UP form — "Start your free trial",
 *     two provider buttons (Google primary, Microsoft secondary), trust line,
 *     mode toggle, and legal footer.
 *
 * Only Google + Microsoft exist — no password field, no other providers. Real
 * Google "G" + Microsoft 4-square logos. Example data only.
 *
 *   <OnboardingSignIn />
 */
import MockScreen from "./MockScreen.astro"
import ChiefyGem from "./ChiefyGem.astro"
import ProviderLogo from "./ProviderLogo.astro"
---

<MockScreen
    title="Chiefy · Sign in"
    figcaption="Sign in with the inbox you already use — Google or Microsoft. Chiefy never sees your password."
>
    <div class="hms-auth">
        {/* LEFT — brand pane (always dark) */}
        <div class="hms-auth-left">
            <span class="hms-auth-glow" aria-hidden="true"></span>
            <div class="hms-auth-lockup">
                <ChiefyGem size={44} title="Chiefy logo" />
                <span class="word">Chiefy</span>
            </div>
            <div class="hms-auth-rule" aria-hidden="true"></div>
            <p class="hms-auth-quote">
                Your AI chief of staff for Gmail and Outlook — drafts replies in your voice, organizes your inbox, and keeps your day on track.
            </p>
        </div>

        {/* RIGHT — form */}
        <div class="hms-auth-right">
            <h2 class="hms-auth-h">Start your free trial</h2>
            <p class="hms-auth-subh">Connect the inbox you want to use with Chiefy</p>

            <div class="hms-provider-stack">
                <button class="hms-provider-btn primary" type="button">
                    <ProviderLogo name="google-g" size={19} />
                    Continue with Google
                </button>
                <button class="hms-provider-btn secondary" type="button">
                    <ProviderLogo name="ms-squares" size={17} />
                    Continue with Microsoft
                </button>
            </div>

            <div class="hms-trust-row">
                <span>Free 14-day trial</span>
                <span class="sep" aria-hidden="true"></span>
                <span>Cancel anytime</span>
            </div>

            <p class="hms-auth-toggle">
                Already have an account? <a href="#">Log in</a>
            </p>
            <p class="hms-auth-legal">
                By continuing, you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.
            </p>
        </div>
    </div>
</MockScreen>
