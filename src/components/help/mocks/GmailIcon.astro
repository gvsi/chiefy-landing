---
/**
 * GmailIcon — inline SVG icon set for the Gmail-native mocks. Material-style
 * line/solid glyphs matching Gmail's web UI. Decorative by default (aria-hidden);
 * pass `title` to expose an accessible name. Inherits `currentColor`, so the
 * parent Gmail class controls color (no hardcoded fills here except the
 * multicolor Gmail "M" logo, which is brand-fixed).
 *
 *   <GmailIcon name="star" />
 *   <GmailIcon name="star-filled" />          // active star (fill currentColor)
 *   <GmailIcon name="compose" size={20} />
 *   <GmailIcon name="gmail-logo" />           // the multicolor M envelope
 */
type Props = {
    name: string
    size?: number
    title?: string
    class?: string
}

const { name, size, title, class: className } = Astro.props

const common = {
    width: size,
    height: size,
    class: className,
    role: (title ? "img" : undefined) as "img" | undefined,
    "aria-label": title,
    "aria-hidden": (title ? undefined : "true") as "true" | undefined,
    focusable: "false",
}
const stroke = {
    fill: "none",
    stroke: "currentColor",
    "stroke-width": 1.9,
    "stroke-linecap": "round",
    "stroke-linejoin": "round",
} as const
---

{
    name === "gmail-logo" && (
        <svg {...common} viewBox="0 0 24 24" fill="none">
            {title && <title>{title}</title>}
            <path d="M22 5.5v13a1.5 1.5 0 0 1-1.5 1.5H18V9.4l-6 4.5-6-4.5V19.5H3.5A1.5 1.5 0 0 1 2 18.5v-13l1.6-1.2 1 .8L12 10.4l6.4-5.3 1-.8L21 5.5h1z" fill="#4285f4" />
            <path d="M6 19.5V9.4l6 4.5V20H6z" fill="#34a853" />
            <path d="M18 19.5V9.4l-6 4.5V20h6z" fill="#fbbc04" opacity="0" />
            <path d="M2 5.5 12 13l10-7.5L20.4 4H3.6L2 5.5z" fill="#ea4335" />
            <path d="M2 5.5v.0L3.5 4h.1l-1.6 1.5z" fill="#c5221f" />
        </svg>
    )
}
{
