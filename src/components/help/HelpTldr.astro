---
/**
 * HelpTldr — labeled "TL;DR" callout for the top of an article. MDX-usable:
 *   <HelpTldr>One or two sentences that summarize the whole article.</HelpTldr>
 * The label text comes from HELP_UI; the body is the default slot.
 */
import { HELP_UI } from "../../content/help/_ui"
---

<div class="help-tldr">
    <span class="l">{HELP_UI.article.tldr}</span>
    <div class="help-tldr-body"><slot /></div>
</div>
