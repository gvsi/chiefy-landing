---
/**
 * HelpSidebar — sticky left nav for section/article pages. Pure presenter: the
 * caller (Phase 2 layouts) builds the grouped links from HELP_CATEGORIES and the
 * current article set. Two shapes are supported via props:
 *   - section index: grouped category links (no `back`).
 *   - article view: a single "All topics" back link + the section's articles.
 * Hidden under 1000px (the article body takes the full width) — see help.css.
 */
import HelpIcon from "./HelpIcon.astro"

type SidebarLink = { label: string; href: string; active?: boolean }
type SidebarGroup = { heading: string; links: SidebarLink[] }

type Props = {
    groups: SidebarGroup[]
    /** Optional "All topics" back link rendered above the groups (article view). */
    back?: { label: string; href: string }
}

const { groups, back } = Astro.props
---

<aside class="help-sidebar">
    {
        back && (
            <a class="help-sidebar-back" href={back.href}>
                <HelpIcon name="arrow-left" size={14} stroke={2} />
                {back.label}
            </a>
        )
    }
    {
        groups.map((group) => (
            <div class="grp">
                <div class="grp-h">{group.heading}</div>
                {group.links.map((link) => (
                    <a href={link.href} class={link.active ? "active" : undefined} aria-current={link.active ? "page" : undefined}>
                        {link.label}
                    </a>
                ))}
            </div>
        ))
    }
</aside>
