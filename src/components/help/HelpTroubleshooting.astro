---
/**
 * HelpTroubleshooting — the "something not working?" band on the help home.
 * Left: a short heading + subtitle. Right: a wrapping row of symptom chips from
 * HELP_UI.troubleshooting.symptoms. Symptoms link out once their fixing article
 * exists (Phase 6); until then each chip renders as static text.
 */
import { HELP_UI } from "../../content/help/_ui"

const { title, subtitle, symptoms } = HELP_UI.troubleshooting
---

<div class="help-band">
    <div class="bt">
        <h3>{title}</h3>
        <p>{subtitle}</p>
    </div>
    <div class="help-symptoms">
        {
            symptoms.map((symptom) =>
                symptom.href ? (
                    <a class="help-symptom" href={symptom.href}>
                        {symptom.title}
                    </a>
                ) : (
                    <span class="help-symptom">{symptom.title}</span>
                ),
            )
        }
    </div>
</div>
