---
/**
 * HelpHero — help-center home hero: eyebrow + Domine headline with one gradient
 * highlight word + a Search / "Ask Chiefy · soon" toggle. The Search control is
 * a real button carrying `js-help-search`; the SearchModal island (rendered once
 * per help route) binds the ⌘K command palette to any element with that class.
 * The "Ask Chiefy" segment is visual-only (the AI layer ships later).
 *
 * Copy comes from HELP_UI (help-local strings) — never from t(messages, ...).
 */
import HelpIcon from "./HelpIcon.astro"
import { HELP_UI } from "../../content/help/_ui"

type PopularLink = { label: string; href: string }

type Props = {
    /** Optional "Popular: …" quick links rendered under the search bar. */
    popular?: PopularLink[]
}

const { popular = [] } = Astro.props
const { hero, search } = HELP_UI
---

<header class="help-hero">
    <div class="help-wrap">
        <div class="help-eyebrow">{hero.eyebrow}</div>
        <h1 class="help-title">
            {hero.title} <span class="help-grad">{hero.titleHighlight}</span>
        </h1>
        <p class="help-sub">{hero.subtitle}</p>

        <div class="help-hero-search">
            <div class="help-toggle" role="group" aria-label={hero.eyebrow}>
                <button type="button" class="seg active js-help-search">
                    <HelpIcon name="search" size={14} stroke={2} />
                    {search.searchTab}
                </button>
                <span class="seg" aria-disabled="true">
                    {search.askTab}
                    <span class="help-soon">{search.soon}</span>
                </span>
            </div>

            <button type="button" class="help-searchbar js-help-search" aria-label={search.placeholder}>
                <HelpIcon name="search" size={20} stroke={1.8} />
                <span class="ph">{search.barPlaceholder}</span>
                <span class="help-kbd">⌘K</span>
            </button>

            {
                popular.length > 0 && (
                    <p class="help-popular">
                        {search.popular}
                        {popular.map((link, i) => (
                            <>
                                <a href={link.href}>{link.label}</a>
                                {i < popular.length - 1 ? <span aria-hidden="true">·</span> : null}
                            </>
                        ))}
                    </p>
                )
            }
        </div>
    </div>
</header>
