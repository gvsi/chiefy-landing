---
/**
 * HelpBreadcrumb — Help center › Category › Article trail. The last item is the
 * current page (rendered as plain text); earlier items link. Used by both the
 * category index and the article layout.
 *
 * Carries the only visible search opener on category + article pages (the home
 * has its own hero trigger): a compact `js-help-search` button that the
 * SearchModal island binds to (⌘K / click). Pushed to the trailing edge of the
 * breadcrumb row so it stays out of the trail but on-screen.
 */
import HelpIcon from "./HelpIcon.astro"
import { HELP_UI } from "../../content/help/_ui"

type Crumb = { label: string; href?: string }

type Props = {
    items: Crumb[]
}

const { items } = Astro.props
const { search } = HELP_UI
---

<nav class="help-breadcrumb" aria-label="Breadcrumb">
    {
        items.map((item, i) => (
            <>
                {item.href && i < items.length - 1 ? (
                    <a href={item.href}>{item.label}</a>
                ) : (
                    <span aria-current="page">{item.label}</span>
                )}
                {i < items.length - 1 ? (
                    <span class="sep" aria-hidden="true">
                        ›
                    </span>
                ) : null}
            </>
        ))
    }
    <button type="button" class="help-breadcrumb-search js-help-search" aria-label={search.placeholder}>
        <HelpIcon name="search" size={15} stroke={1.8} />
        <span class="lbl">{search.searchTab}</span>
        <span class="help-kbd" aria-hidden="true">⌘K</span>
    </button>
</nav>
