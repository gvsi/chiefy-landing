---
/**
 * HelpIcon — inline Lucide-style stroke SVG for help-center iconography.
 *
 * Maps a category `iconKey` (rocket | pen | labels | summary | chat | calendar
 * | mailboxes | shield | card) — the keys used by HELP_CATEGORIES — to a
 * single-color stroke SVG. A handful of extra keys (sparkle, info, warn,
 * arrow-right, arrow-left, search, sliders, thumbs-up, thumbs-down) back the
 * article rows, callouts, and mock figures.
 *
 * All paths use `currentColor` + ~1.7 stroke so the icon inherits its parent's
 * color (tiles tint via `.ic`, rows stay muted, etc.). No emoji.
 */
type Props = {
    name: string
    size?: number
    /** Stroke width override (defaults to 1.7, the Lucide-ish house weight). */
    stroke?: number
    class?: string
}

const { name, size = 20, stroke = 1.7, class: className } = Astro.props

// Each entry is the inner markup of a 24×24 viewBox icon.
const ICONS: Record<string, string> = {
    // ── category icons (HELP_CATEGORIES.iconKey) ──
    rocket: `<path d="M5 13l-2 6 6-2"/><path d="M14.5 5.5l4 4"/><path d="M13 6l-8 8 4 4 8-8a3 3 0 00-4-4z"/>`,
    pen: `<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/>`,
    labels: `<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12l2 2 4-4"/>`,
    summary: `<path d="M4 6h16M4 12h10M4 18h7"/>`,
    chat: `<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>`,
    calendar: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>`,
    mailboxes: `<path d="M22 6l-10 7L2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/>`,
    shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>`,
    card: `<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>`,

    // ── supporting icons (rows, callouts, figures, modal) ──
    sparkle: `<path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/>`,
    sliders: `<path d="M4 7h16M4 12h10M4 17h7"/>`,
    mail: `<path d="M22 6l-10 7L2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/>`,
    "doc-edit": `<path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4z"/>`,
    info: `<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>`,
    note: `<path d="M4 4h16v12H5.2L4 17.2z"/>`,
    chart: `<path d="M3 17l6-6 4 4 8-8"/>`,
    globe: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"/>`,
    warn: `<path d="M10.3 3.8L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.8a2 2 0 00-3.4 0z"/><path d="M12 9v4M12 17h.01"/>`,
    search: `<circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/>`,
    "arrow-right": `<path d="M9 6l6 6-6 6"/>`,
    "arrow-left": `<path d="M15 6l-6 6 6 6"/>`,
    "thumbs-up": `<path d="M7 11v9H4a1 1 0 01-1-1v-7a1 1 0 011-1zM7 11l4-7a2 2 0 012 2v3h5.5a2 2 0 012 2.3l-1.2 6A2 2 0 0119.3 20H7"/>`,
    "thumbs-down": `<path d="M17 13V4h3a1 1 0 011 1v7a1 1 0 01-1 1zM17 13l-4 7a2 2 0 01-2-2v-3H5.5a2 2 0 01-2-2.3l1.2-6A2 2 0 016.7 4H17"/>`,
}

const markup = ICONS[name] ?? ICONS.info
---

<svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={className}
    set:html={markup}
/>
