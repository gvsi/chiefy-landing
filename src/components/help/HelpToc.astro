---
/**
 * HelpToc — the right-rail "On this page" table of contents, built from Astro's
 * render() `headings`. Only depth-2 headings (article sections) are listed, each
 * linking to its slug anchor. Static / zero-JS: no scroll-spy island (active
 * highlighting would require client JS, which the help center avoids outside the
 * search + helpful islands). Renders nothing when there are fewer than 2 sections.
 */
import type { MarkdownHeading } from "astro"
import { HELP_UI } from "../../content/help/_ui"

type Props = {
    headings: MarkdownHeading[]
}

const { headings } = Astro.props
const sections = headings.filter((heading) => heading.depth === 2)
---

{
    sections.length > 1 && (
        <aside class="help-toc">
            <div class="h">{HELP_UI.article.onThisPage}</div>
            {sections.map((section) => (
                <a href={`#${section.slug}`}>{section.text}</a>
            ))}
        </aside>
    )
}
