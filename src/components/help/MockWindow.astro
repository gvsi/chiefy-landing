---
/**
 * MockWindow — a stylized "rendered in-product" window used for article figures
 * instead of real screenshots. Shows a macOS-style title bar (three dots + a
 * label) and a body slot. MDX-usable; compose <SettingRow>/<MailRow> inside it.
 *
 *   <MockWindow title="Chiefy · Settings → Smart Drafts">
 *     <SettingRow title="Autodraft" description="…" anno="A" />
 *   </MockWindow>
 *   <MockWindow title="Gmail · Inbox" tight figcaption="Threads that need a reply…">
 *     <MailRow … /> <MailRow … last />
 *   </MockWindow>
 *
 * `tight` trims vertical body padding (good for stacked MailRows). `figcaption`
 * renders an italic caption beneath the window.
 */
type Props = {
    /** Label shown in the window title bar. */
    title?: string
    /** Italic caption rendered under the window. */
    figcaption?: string
    /** Trim body padding (for stacked mail rows). */
    tight?: boolean
}

const { title, figcaption, tight = false } = Astro.props
---

<figure class="help-mock-figure">
    <div class="help-mock">
        <div class="help-mock-bar">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            {title && <span class="ttl">{title}</span>}
        </div>
        <div class={`help-mock-body${tight ? " tight" : ""}`}>
            <slot />
        </div>
    </div>
    {figcaption && <figcaption class="help-figcap">{figcaption}</figcaption>}
</figure>
