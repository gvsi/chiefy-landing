---
/**
 * SettingRow — a settings toggle row inside a <MockWindow>, used to illustrate
 * in-product settings (e.g. turning Autodraft on). MDX-usable:
 *
 *   <SettingRow title="Autodraft" anno="A"
 *     description="Automatically prepare replies for emails that need one" />
 *   <SettingRow title="Signature" description="…" on={false} iconKey="pen" />
 *
 * The leading icon defaults to the Smart Drafts pen. `on` controls the switch
 * (default on). `anno` renders a small annotation marker beside the title.
 */
import HelpIcon from "./HelpIcon.astro"

type Props = {
    title: string
    description: string
    /** Icon key for the leading badge (defaults to the Smart Drafts pen). */
    iconKey?: string
    /** Switch state (default on). */
    on?: boolean
    /** Optional annotation marker letter/number beside the title. */
    anno?: string
}

const { title, description, iconKey = "pen", on = true, anno } = Astro.props
---

<div class="help-set-row">
    <span class="si">
        <HelpIcon name={iconKey} size={18} stroke={1.8} />
    </span>
    <span class="st">
        <b>
            {title}
            {anno && <span class="help-anno">{anno}</span>}
        </b>
        <span>{description}</span>
    </span>
    <span class={`help-switch${on ? "" : " off"}`} role="img" aria-label={on ? "On" : "Off"}></span>
</div>
