---
/**
 * SearchModal — the ⌘K command-palette for the help center, wired to the static
 * Pagefind index built in `astro:build:done` (Task 4.1).
 *
 * Behaviour (single tiny `is:inline` island, loaded only on routes that render
 * this component — the help layouts — keeping the rest of the site zero-JS):
 *   - opens on ⌘K/Ctrl-K and on click of any `.js-help-search` element,
 *   - closes on Esc or overlay click,
 *   - on FIRST open, lazy-imports `/pagefind/pagefind.js` and initialises it,
 *   - debounces the input and renders live results (title + category·excerpt
 *     subline) linking to the article URL,
 *   - keeps the deferred "Ask Chiefy this question · soon" row (no AI yet),
 *   - keyboard nav: ↑/↓ move the selection, ↵ opens it, Esc closes,
 *   - degrades gracefully: if the index is missing (e.g. `astro dev`, where
 *     Pagefind never runs) or a query returns nothing, it shows a calm
 *     idle / empty state instead of throwing,
 *   - also toggles the site theme for any `.js-help-theme` control, matching
 *     BaseLayout's storage convention (key "theme"; light => data-theme="light").
 *
 * `prefers-reduced-motion` is honoured by help.css (the pop animation is
 * disabled there); the JS adds no motion of its own.
 */
import HelpIcon from "./HelpIcon.astro"
import { HELP_UI } from "../../content/help/_ui"
import type { Locale } from "../../i18n/locales"

type Props = {
    locale: Locale
}

const { locale } = Astro.props
const { search } = HELP_UI
// `locale` is reserved for future per-locale help indexes (Pagefind splits by
// language); the launch index is English-only.
void locale
---

<div
    class="help-modal"
    id="help-search-modal"
    role="dialog"
    aria-modal="true"
    aria-label={search.placeholder}
    data-copy-idle={search.idle}
    data-copy-empty={search.noResults}
    data-copy-unavailable={search.unavailable}
    data-copy-top={search.topResults}
    hidden
>
    <button type="button" class="ov" data-help-close aria-label={search.close}></button>
    <div class="box">
        <div class="sb">
            <HelpIcon name="search" size={20} stroke={1.8} />
            <input
                id="help-search-input"
                type="search"
                placeholder={search.placeholder}
                autocomplete="off"
                aria-label={search.placeholder}
                aria-controls="help-search-results"
                role="combobox"
                aria-expanded="false"
                aria-autocomplete="list"
            />
            <span class="help-kbd">ESC</span>
        </div>

        <div class="ask">
            <HelpIcon name="chat" size={16} stroke={1.8} />
            {search.askThisQuestion}
            <span class="help-soon">{search.soon}</span>
        </div>

        <div class="results" id="help-search-results" role="listbox" aria-label={search.topResults}>
            <div class="help-search-state" data-help-state>{search.idle}</div>
        </div>

        {/* Template cloned per live result; keeps the result SVG out of the island JS. */}
        <template id="help-search-result-template">
            <a class="ri" role="option" href="#">
                <span class="ric">
                    <HelpIcon name="doc-edit" size={16} />
                </span>
                <span>
                    <b data-result-title></b>
                    <span data-result-sub></span>
                </span>
            </a>
        </template>

        <div class="foot">
            <span><span class="help-kbd">↑↓</span>{search.navigate}</span>
            <span><span class="help-kbd">↵</span>{search.open}</span>
            <span><span class="help-kbd">esc</span>{search.close}</span>
        </div>
    </div>
</div>

<script is:inline>
    ;(() => {
        const modal = document.getElementById("help-search-modal")
        if (!modal || modal.dataset.bound === "1") return
        modal.dataset.bound = "1"

        // Server-rendered copy travels via data-* attributes (is:inline scripts
        // are not Astro-processed, so define:vars is unavailable here).
        const copy = {
            idle: modal.dataset.copyIdle || "",
            empty: modal.dataset.copyEmpty || "",
            unavailable: modal.dataset.copyUnavailable || "",
            topResults: modal.dataset.copyTop || "",
        }

        const input = /** @type {HTMLInputElement | null} */ (document.getElementById("help-search-input"))
        const results = document.getElementById("help-search-results")
        const template = /** @type {HTMLTemplateElement | null} */ (
            document.getElementById("help-search-result-template")
        )

        const closeControl = modal.querySelector("[data-help-close]")

        let pagefind = null // resolved Pagefind module, or "unavailable"
        let pagefindLoading = null // in-flight import promise (load once)
        let debounceTimer = 0
        let activeQueryToken = 0 // guards against out-of-order async responses
        let selected = -1
        let lastFocused = null // element to restore focus to on close

        // Focusable controls inside the modal box, in DOM order: the input, every
        // visible result link, and the close control. Used to trap Tab/Shift+Tab.
        const focusables = () => {
            const list = []
            if (input) list.push(input)
            for (const option of optionEls()) list.push(option)
            if (closeControl) list.push(closeControl)
            return list
        }

        const open = () => {
            // Remember the opener so focus can return there on close (a11y).
            lastFocused =
                document.activeElement instanceof HTMLElement ? document.activeElement : null
            modal.hidden = false
            modal.classList.add("open")
            if (input) input.setAttribute("aria-expanded", "true")
            window.setTimeout(() => {
                if (input) input.focus()
            }, 30)
            // Warm the index on first open so the first keystroke feels instant.
            void ensurePagefind()
        }
        const close = () => {
            modal.classList.remove("open")
            modal.hidden = true
            if (input) {
                input.setAttribute("aria-expanded", "false")
                input.removeAttribute("aria-activedescendant")
            }
            // Restore focus to whatever opened the modal (button, link, body).
            if (lastFocused && document.contains(lastFocused)) {
                lastFocused.focus()
            }
            lastFocused = null
        }

        const ensurePagefind = () => {
            if (pagefind) return Promise.resolve(pagefind)
            if (pagefindLoading) return pagefindLoading
            pagefindLoading = import(/* @vite-ignore */ "/pagefind/pagefind.js")
                .then(async (module) => {
                    if (module && typeof module.init === "function") {
                        try {
                            await module.init()
                        } catch (error) {
                            /* init is best-effort; search still works without it */
                        }
                    }
                    pagefind = module
                    return module
                })
                .catch(() => {
                    // No built index (dev) or a load failure — degrade to a calm state.
                    pagefind = "unavailable"
                    return pagefind
                })
            return pagefindLoading
        }

        const renderState = (message) => {
            if (!results) return
            const node = document.createElement("div")
            node.className = "help-search-state"
            node.setAttribute("data-help-state", "")
            node.textContent = message
            results.replaceChildren(node)
            selected = -1
            if (input) input.removeAttribute("aria-activedescendant")
        }

        const optionEls = () =>
            results ? /** @type {HTMLAnchorElement[]} */ (Array.from(results.querySelectorAll(".ri"))) : []

        const setSelection = (next) => {
            const options = optionEls()
            if (options.length === 0) {
                selected = -1
                if (input) input.removeAttribute("aria-activedescendant")
                return
            }
            selected = (next + options.length) % options.length
            options.forEach((el, index) => {
                const isSelected = index === selected
                el.classList.toggle("sel", isSelected)
                el.setAttribute("aria-selected", isSelected ? "true" : "false")
                if (isSelected) el.scrollIntoView({ block: "nearest" })
            })
            // Expose the active option to assistive tech (combobox pattern).
            const activeId = options[selected].id
            if (input && activeId) input.setAttribute("aria-activedescendant", activeId)
        }

        const renderResults = (items) => {
            if (!results || !template) return
            if (items.length === 0) {
                renderState(copy.empty)
                return
            }
            const fragment = document.createDocumentFragment()
            const heading = document.createElement("div")
            heading.className = "rg"
            heading.textContent = copy.topResults
            fragment.appendChild(heading)

            let optionIndex = 0
            for (const item of items) {
                const clone = /** @type {DocumentFragment} */ (template.content.cloneNode(true))
                const anchor = clone.querySelector(".ri")
                const titleEl = clone.querySelector("[data-result-title]")
                const subEl = clone.querySelector("[data-result-sub]")
                if (anchor) {
                    anchor.setAttribute("href", item.href)
                    // Stable id so aria-activedescendant can reference the option.
                    anchor.id = `help-search-result-${optionIndex++}`
                }
                if (titleEl) titleEl.textContent = item.title
                // Excerpt is sanitised plain text; the category prefixes the subline.
                if (subEl) subEl.textContent = item.subtitle
                fragment.appendChild(clone)
            }
            results.replaceChildren(fragment)
            setSelection(0)
        }

        const stripHtml = (value) => {
            const tmp = document.createElement("div")
            tmp.innerHTML = value || ""
            return (tmp.textContent || "").replace(/\s+/g, " ").trim()
        }

        const cleanUrl = (url) => (url || "").replace(/\.html$/, "").replace(/\/index$/, "") || "/"

        const runSearch = async (rawQuery) => {
            const query = rawQuery.trim()
            const token = ++activeQueryToken
            if (query === "") {
                renderState(copy.idle)
                return
            }

            const module = await ensurePagefind()
            if (token !== activeQueryToken) return // superseded by a newer query
            if (!module || module === "unavailable") {
                renderState(copy.unavailable)
                return
            }

            let response
            try {
                response = await module.search(query)
            } catch (error) {
                if (token === activeQueryToken) renderState(copy.unavailable)
                return
            }
            if (token !== activeQueryToken) return

            const raw = response && Array.isArray(response.results) ? response.results.slice(0, 8) : []
            const resolved = await Promise.all(
                raw.map(async (result) => {
                    try {
                        return await result.data()
                    } catch (error) {
                        return null
                    }
                }),
            )
            if (token !== activeQueryToken) return

            const items = resolved
                .filter(Boolean)
                .map((data) => {
                    const meta = data.meta || {}
                    const category =
                        data.filters && Array.isArray(data.filters.category) ? data.filters.category[0] : ""
                    const excerpt = stripHtml(data.excerpt)
                    const subtitle = category && excerpt ? `${category} · ${excerpt}` : category || excerpt
                    return {
                        title: meta.title || stripHtml(data.content).slice(0, 60) || data.url,
                        subtitle,
                        href: cleanUrl(data.url),
                    }
                })
            renderResults(items)
        }

        // Open triggers.
        document.querySelectorAll(".js-help-search").forEach((el) => {
            el.addEventListener("click", (event) => {
                event.preventDefault()
                open()
            })
        })

        if (closeControl) closeControl.addEventListener("click", close)

        // Input → debounced search.
        if (input) {
            input.addEventListener("input", () => {
                window.clearTimeout(debounceTimer)
                debounceTimer = window.setTimeout(() => {
                    void runSearch(input.value)
                }, 150)
            })
        }

        document.addEventListener("keydown", (event) => {
            const isOpen = modal.classList.contains("open")
            if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
                event.preventDefault()
                isOpen ? close() : open()
                return
            }
            if (!isOpen) return
            if (event.key === "Escape") {
                close()
                return
            }
            if (event.key === "Tab") {
                // Trap focus inside the modal box: cycle across input → results → close.
                const items = focusables()
                if (items.length === 0) return
                const first = items[0]
                const last = items[items.length - 1]
                const active = document.activeElement
                if (event.shiftKey) {
                    if (active === first || !items.includes(active)) {
                        event.preventDefault()
                        last.focus()
                    }
                } else if (active === last || !items.includes(active)) {
                    event.preventDefault()
                    first.focus()
                }
                return
            }
            const options = optionEls()
            if (event.key === "ArrowDown") {
                event.preventDefault()
                setSelection(selected < 0 ? 0 : selected + 1)
            } else if (event.key === "ArrowUp") {
                event.preventDefault()
                setSelection(selected < 0 ? options.length - 1 : selected - 1)
            } else if (event.key === "Enter") {
                const target = options[selected]
                if (target) {
                    event.preventDefault()
                    window.location.assign(target.getAttribute("href") || "/")
                }
            }
        })

        // Theme toggle (repo convention: key "theme"; light => data-theme=light).
        const applyTheme = (next) => {
            try {
                localStorage.setItem("theme", next)
            } catch (error) {
                /* storage may be unavailable */
            }
            if (next === "light") document.documentElement.setAttribute("data-theme", "light")
            else document.documentElement.removeAttribute("data-theme")
        }
        document.querySelectorAll(".js-help-theme").forEach((el) => {
            el.addEventListener("click", () => {
                const isLight = document.documentElement.getAttribute("data-theme") === "light"
                applyTheme(isLight ? "dark" : "light")
            })
        })
    })()
</script>
