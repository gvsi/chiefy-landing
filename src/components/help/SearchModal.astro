---
/**
 * SearchModal — the ⌘K command-palette shell + open/close/theme island, ported
 * from the prototype help.js. This Phase-3 version renders the STATIC markup
 * (search field, the deferred "Ask Chiefy this question · soon" row, and a small
 * set of seed "Top results"). Live Pagefind result wiring is Phase 4.
 *
 * The island is a single tiny is:inline script that:
 *   - opens the modal on ⌘K/Ctrl-K and on click of any `.js-help-search` element
 *     (the hero search bar/toggle, a nav search affordance, etc.),
 *   - closes on Esc or overlay click,
 *   - toggles the site theme for any `.js-help-theme` control, using the repo's
 *     storage convention (key "theme"; light => data-theme="light", dark =>
 *     attribute removed) so it matches BaseLayout's inline theme bootstrap.
 *
 * It loads ONLY on routes that render this component (the help layouts), keeping
 * the rest of the site zero-JS.
 */
import HelpIcon from "./HelpIcon.astro"
import { HELP_UI } from "../../content/help/_ui"
import { localizedPath } from "../../i18n/routing"
import type { Locale } from "../../i18n/locales"

type SeedResult = { title: string; subtitle: string; href: string; iconKey: string }

type Props = {
    locale: Locale
}

const { locale } = Astro.props
const { search } = HELP_UI

const helpHref = (category: string) => localizedPath(locale, { kind: "helpCategory", category })

// Seed results shown before Pagefind is wired (Phase 4). Linked to real category
// indexes so the shell is navigable today.
const seedResults: SeedResult[] = [
    { title: "Turn on Autodraft", subtitle: "Smart Drafts · let Chiefy pre-draft replies automatically", href: helpHref("smart-drafts"), iconKey: "pen" },
    { title: "Using Smart Drafts on demand", subtitle: "Smart Drafts · write and reply in your voice", href: helpHref("smart-drafts"), iconKey: "pen" },
    { title: "How Auto Labels work", subtitle: "Auto Labels · automatic email sorting", href: helpHref("auto-labels"), iconKey: "labels" },
    { title: "Connect a second mailbox", subtitle: "Connected Mailboxes · add Gmail or Outlook accounts", href: helpHref("connected-mailboxes"), iconKey: "mailboxes" },
    { title: "Cancel my plan", subtitle: "Account & billing · manage your subscription", href: helpHref("account-billing"), iconKey: "card" },
]
---

<div class="help-modal" id="help-search-modal" role="dialog" aria-modal="true" aria-label={search.placeholder} hidden>
    <button type="button" class="ov" data-help-close aria-label={search.close}></button>
    <div class="box">
        <div class="sb">
            <HelpIcon name="search" size={20} stroke={1.8} />
            <input id="help-search-input" type="search" placeholder={search.placeholder} autocomplete="off" aria-label={search.placeholder} />
            <span class="help-kbd">ESC</span>
        </div>

        <div class="ask">
            <HelpIcon name="chat" size={16} stroke={1.8} />
            {search.askThisQuestion}
            <span class="help-soon">{search.soon}</span>
        </div>

        <div class="results" id="help-search-results">
            <div class="rg">{search.topResults}</div>
            {
                seedResults.map((result, i) => (
                    <a class={`ri${i === 0 ? " sel" : ""}`} href={result.href}>
                        <span class="ric">
                            <HelpIcon name={result.iconKey} size={16} />
                        </span>
                        <span>
                            <b>{result.title}</b>
                            <span>{result.subtitle}</span>
                        </span>
                    </a>
                ))
            }
        </div>

        <div class="foot">
            <span><span class="help-kbd">↑↓</span>{search.navigate}</span>
            <span><span class="help-kbd">↵</span>{search.open}</span>
            <span><span class="help-kbd">esc</span>{search.close}</span>
        </div>
    </div>
</div>

<script is:inline>
    (() => {
        const modal = document.getElementById("help-search-modal")
        if (!modal || modal.dataset.bound === "1") return
        modal.dataset.bound = "1"
        const input = document.getElementById("help-search-input")

        const open = () => {
            modal.hidden = false
            modal.classList.add("open")
            window.setTimeout(() => {
                if (input) input.focus()
            }, 30)
        }
        const close = () => {
            modal.classList.remove("open")
            modal.hidden = true
        }

        document.querySelectorAll(".js-help-search").forEach((el) => {
            el.addEventListener("click", (event) => {
                event.preventDefault()
                open()
            })
        })

        const closeEl = modal.querySelector("[data-help-close]")
        if (closeEl) closeEl.addEventListener("click", close)

        document.addEventListener("keydown", (event) => {
            if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
                event.preventDefault()
                modal.classList.contains("open") ? close() : open()
            }
            if (event.key === "Escape" && modal.classList.contains("open")) close()
        })

        // Theme toggle (repo convention: key "theme"; light => data-theme=light).
        const applyTheme = (next) => {
            try {
                localStorage.setItem("theme", next)
            } catch (error) {
                /* storage may be unavailable */
            }
            if (next === "light") document.documentElement.setAttribute("data-theme", "light")
            else document.documentElement.removeAttribute("data-theme")
        }
        document.querySelectorAll(".js-help-theme").forEach((el) => {
            el.addEventListener("click", () => {
                const isLight = document.documentElement.getAttribute("data-theme") === "light"
                applyTheme(isLight ? "dark" : "light")
            })
        })
    })()
</script>
