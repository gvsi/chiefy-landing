---
/**
 * HelpCategoryGrid — the 3×3 "Browse by topic" grid on the help home, built from
 * HELP_CATEGORIES. Each tile links to its category index via the localized path
 * helper. An optional `counts` map renders the "N ARTICLES" footer per category;
 * omitted/zero counts render no footer (the corpus is authored in Phase 6).
 */
import HelpIcon from "./HelpIcon.astro"
import { HELP_CATEGORIES } from "../../content/help/_categories"
import { HELP_UI } from "../../content/help/_ui"
import { localizedPath } from "../../i18n/routing"
import type { Locale } from "../../i18n/locales"

type Props = {
    locale: Locale
    /** Map of categoryId -> article count, e.g. { "smart-drafts": 10 }. */
    counts?: Record<string, number>
}

const { locale, counts = {} } = Astro.props
const categories = [...HELP_CATEGORIES].sort((a, b) => a.order - b.order)
---

<section class="help-sec">
    <div class="help-sec-head">
        <h2 class="help-sec-title">{HELP_UI.browseByTopic}</h2>
    </div>
    <div class="help-tiles">
        {
            categories.map((category) => {
                const count = counts[category.id] ?? 0
                return (
                    <a class="help-tile" href={localizedPath(locale, { kind: "helpCategory", category: category.id })}>
                        <span class="ic">
                            <HelpIcon name={category.iconKey} size={20} />
                        </span>
                        <h3>{category.name}</h3>
                        <p>{category.blurb}</p>
                        {count > 0 && (
                            <span class="count">
                                {count} {HELP_UI.articlesLabel.toUpperCase()}
                            </span>
                        )}
                    </a>
                )
            })
        }
    </div>
</section>
