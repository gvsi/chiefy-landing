---
/**
 * HelpStep — one item inside <HelpSteps>. Renders an <li> whose number and
 * connector rail are drawn by CSS counters (see .help-steps in help.css). The
 * `title` becomes the step heading; the default slot is the step body, which may
 * contain paragraphs, <MockWindow> figures, notes, etc.
 *
 *   <HelpStep title="Switch Autodraft on">
 *     Toggle Autodraft on. <MockWindow title="…">…</MockWindow>
 *   </HelpStep>
 *
 * `anno` renders a small circular annotation marker (e.g. "A") next to the title
 * to cross-reference a callout inside an adjacent figure.
 */
type Props = {
    title: string
    /** Optional annotation marker letter/number shown beside the title. */
    anno?: string
}

const { title, anno } = Astro.props
---

<li>
    <h3>
        {title}
        {anno && <span class="help-anno">{anno}</span>}
    </h3>
    <slot />
</li>
