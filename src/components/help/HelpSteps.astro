---
/**
 * HelpSteps — the numbered, connected step list (auto-numbered via CSS counters,
 * with the connecting rail). MDX-usable as the wrapper around <HelpStep> items:
 *
 *   <HelpSteps>
 *     <HelpStep title="Open Chiefy settings">In Gmail, open the side panel…</HelpStep>
 *     <HelpStep title="Switch Autodraft on">…<MockWindow>…</MockWindow></HelpStep>
 *   </HelpSteps>
 *
 * The numbers and connector rail are pure CSS, so any number of steps works.
 */
---

<ol class="help-steps">
    <slot />
</ol>
