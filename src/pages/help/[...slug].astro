---
import { render } from "astro:content"
import HelpArticleLayout from "../../layouts/HelpArticleLayout.astro"
import { DEFAULT_LOCALE } from "../../i18n/locales"
import { getAllHelpArticles, getHelpAlternates } from "../../i18n/content"

export async function getStaticPaths() {
    const articles = await getAllHelpArticles(DEFAULT_LOCALE)
    return articles.map((article) => ({
        params: { slug: article.slug },
        props: { article },
    }))
}

const { article } = Astro.props
const locale = DEFAULT_LOCALE
const alternates = getHelpAlternates(Astro.site, { kind: "helpArticle", slug: article.slug })
const { Content, headings } = await render(article.entry)
---

<HelpArticleLayout
    locale={locale}
    alternates={alternates}
    title={article.title}
    description={article.description}
    category={article.category}
    type={article.type}
    updatedAt={article.updatedAt}
    keywords={article.keywords}
    relatedSlugs={article.relatedSlugs}
    slug={article.slug}
    headings={headings}
>
    <Content />
</HelpArticleLayout>
