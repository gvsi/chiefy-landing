---
import LegalLayout from "../layouts/LegalLayout.astro"
import { DEFAULT_LOCALE } from "../i18n/locales"
import { alternateLinks, localizedPath } from "../i18n/routing"
import { getLegalContent, getRouteTranslationState, robotsForTranslationState } from "../i18n/content"
import { getMessages, t } from "../i18n/messages/schema"

const locale = DEFAULT_LOCALE
const page = "cookies"
const messages = getMessages(locale)
const contentHtml = getLegalContent(locale, page)
const title = t(messages, "legal.pages.cookies.title")
const description = t(messages, "legal.pages.cookies.description")
const canonicalPath = localizedPath(locale, { kind: "legal", page })
const alternates = alternateLinks(Astro.site, { kind: "legal", page })
const robotsDirectives = robotsForTranslationState(await getRouteTranslationState({ kind: "legal", locale, page }))
---

<LegalLayout
    locale={locale}
    messages={messages}
    alternates={alternates}
    robotsDirectives={robotsDirectives}
    title={title}
    description={description}
    canonicalPath={canonicalPath}
    activeNav="cookies"
    contentHtml={contentHtml}
/>
