---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/nav/Nav.astro";
import Hero from "../../components/sections/Hero.astro";
import HeroBackground from "../../components/sections/HeroBackground.astro";
import InboxHeroMockup from "../../components/sections/InboxHeroMockup.astro";
import MathSection from "../../components/sections/MathSection.astro";
import CategorizationShowcase from "../../components/sections/CategorizationShowcase.astro";
import DraftShowcase from "../../components/sections/DraftShowcase.astro";
import AgentChatShowcase from "../../components/sections/AgentChatShowcase.astro";
import ShowcaseContainer from "../../components/sections/ShowcaseContainer.astro";
import Testimonials from "../../components/sections/Testimonials.astro";
import Pricing from "../../components/sections/Pricing.astro";
import FAQ from "../../components/sections/FAQ.astro";
import FinalCTA from "../../components/sections/FinalCTA.astro";
import Footer from "../../components/sections/Footer.astro";
import { DEFAULT_LOCALE } from "../../i18n/locales";
import { englishOnlyAlternates, localizedPath } from "../../i18n/routing";
import { getAllVerticalContent, getHomeContent, getRouteTranslationState, robotsForTranslationState } from "../../i18n/content";
import { getMessages, t } from "../../i18n/messages/schema";
import { jsonLdScript } from "../../i18n/jsonLd";

type VerticalPageData = Record<string, any>;
const locale = DEFAULT_LOCALE;
const messages = getMessages(locale);
const home = getHomeContent(locale);
const homeSections = home as any;

export async function getStaticPaths() {
    const verticals = getAllVerticalContent(DEFAULT_LOCALE) as VerticalPageData[];

    return verticals.map((data) => {
        const slug = data.slug as string;
        return {
            params: { slug },
            props: { data },
        };
    });
}

const { data } = Astro.props as { data: VerticalPageData };
const canonicalPath = localizedPath(locale, { kind: "vertical", slug: data.slug });
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const alternates = englishOnlyAlternates(Astro.site, { kind: "vertical", slug: data.slug });
const robotsDirectives = robotsForTranslationState(await getRouteTranslationState({ kind: "vertical", locale, slug: data.slug }));
const extraHeadHtml = [
    jsonLdScript({
        "@context": "https://schema.org",
        "@type": "WebPage",
        inLanguage: locale,
        name: data.pageTitle,
        description: data.metaDescription,
        url: canonicalUrl,
    }),
    jsonLdScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        inLanguage: locale,
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: t(messages, "legalNav.home"),
                item: new URL(localizedPath(locale, { kind: "home" }), Astro.site).toString(),
            },
            {
                "@type": "ListItem",
                position: 2,
                name: data.heroBadge ?? data.pageTitle,
                item: canonicalUrl,
            },
        ],
    }),
].join("\n");
---

<BaseLayout
    title={data.pageTitle}
    description={data.metaDescription}
    canonicalPath={canonicalPath}
    ogImagePath="/og.jpg"
    locale={locale}
    alternates={alternates}
    robotsDirectives={robotsDirectives}
    extraHeadHtml={extraHeadHtml}
>
    <Nav locale={locale} messages={messages} alternates={alternates} />
    <main class="relative isolate">
        <HeroBackground />
        <Hero hero={homeSections.hero} heroHeadline={data.heroHeadline} heroSubline={data.heroSubline} heroBadge={data.heroBadge}>
            <div class="mt-10 w-full">
                <InboxHeroMockup inboxHeroMockup={homeSections.inboxHeroMockup} inboxEmails={data.inboxEmails} autodraft={data.autodraft} />
            </div>
        </Hero>
        <MathSection
            messages={messages}
            pricePerBooking={data.math.pricePerBooking}
            bookingUnit={data.math.bookingUnit}
            lostPerMonth={data.math.lostPerMonth}
            monthlyLoss={data.math.monthlyLoss}
            punchline={data.math.punchline}
        />
        <ShowcaseContainer>
            <CategorizationShowcase categorizationShowcase={homeSections.categorizationShowcase} categorizationEmails={data.categorizationEmails} categorizationSubtitle={data.categorizationSubtitle} />
            <DraftShowcase draftShowcase={homeSections.draftShowcase} draft={data.draft} draftSubtitle={data.draftSubtitle} />
            <AgentChatShowcase agentChatShowcase={homeSections.agentChatShowcase} agent={data.agent} agentSubtitle={data.agentSubtitle} />
        </ShowcaseContainer>
        <Testimonials testimonials={homeSections.testimonials} verticalTestimonials={data.testimonials} testimonialsTitle={data.testimonialsTitle} />
        <Pricing pricing={homeSections.pricing} pricingNote={data.pricingNote} />
        <FAQ faq={homeSections.faq} verticalFaqs={data.verticalFaqs} />
    </main>
    <FinalCTA finalCta={homeSections.finalCta} ctaHeadline={data.ctaHeadline} ctaSubline={data.ctaSubline} />
    <Footer locale={locale} messages={messages} />
</BaseLayout>
