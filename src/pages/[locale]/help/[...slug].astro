---
import { render } from "astro:content"
import HelpArticleLayout from "../../../layouts/HelpArticleLayout.astro"
import { DEFAULT_LOCALE, type Locale } from "../../../i18n/locales"
import { getAllHelpArticles, getHelpAlternates, localesWithHelp } from "../../../i18n/content"

// One page per (locale-with-help × article); empty at launch.
export async function getStaticPaths() {
    const locales = (await localesWithHelp()).filter((locale) => locale !== DEFAULT_LOCALE)
    const paths = []
    for (const locale of locales) {
        const articles = await getAllHelpArticles(locale)
        for (const article of articles) {
            paths.push({ params: { locale, slug: article.slug }, props: { locale, article } })
        }
    }
    return paths
}

const { locale, article } = Astro.props as {
    locale: Locale
    article: Awaited<ReturnType<typeof getAllHelpArticles>>[number]
}
const alternates = getHelpAlternates(Astro.site, { kind: "helpArticle", slug: article.slug })
const { Content, headings } = await render(article.entry)
---

<HelpArticleLayout
    locale={locale}
    alternates={alternates}
    title={article.title}
    description={article.description}
    category={article.category}
    type={article.type}
    updatedAt={article.updatedAt}
    keywords={article.keywords}
    relatedSlugs={article.relatedSlugs}
    slug={article.slug}
    headings={headings}
>
    <Content />
</HelpArticleLayout>
