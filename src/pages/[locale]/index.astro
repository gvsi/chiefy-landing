---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/nav/Nav.astro";
import Hero from "../../components/sections/Hero.astro";
import HeroBackground from "../../components/sections/HeroBackground.astro";
import InboxHeroMockup from "../../components/sections/InboxHeroMockup.astro";
import Logos from "../../components/sections/Logos.astro";
import CategorizationShowcase from "../../components/sections/CategorizationShowcase.astro";
import DraftShowcase from "../../components/sections/DraftShowcase.astro";
import AgentChatShowcase from "../../components/sections/AgentChatShowcase.astro";
import ShowcaseContainer from "../../components/sections/ShowcaseContainer.astro";
import Testimonials from "../../components/sections/Testimonials.astro";
import Pricing from "../../components/sections/Pricing.astro";
import FAQ from "../../components/sections/FAQ.astro";
import FinalCTA from "../../components/sections/FinalCTA.astro";
import Footer from "../../components/sections/Footer.astro";
import type { Locale } from "../../i18n/locales";
import { getNonDefaultStaticLocalePaths, localizedPath } from "../../i18n/routing";
import { getAlternateLinksForRoute, getHomeContent, getRouteTranslationState, robotsForTranslationState } from "../../i18n/content";
import { getMessages } from "../../i18n/messages/schema";
import { jsonLdScript } from "../../i18n/jsonLd";
import { jsonLdBrand } from "../../utils/brand";

export function getStaticPaths() {
    return getNonDefaultStaticLocalePaths();
}

const { locale } = Astro.props as { locale: Locale };
const messages = getMessages(locale);
const home = getHomeContent(locale);
const homeSections = home as any;
const homeMeta = home.meta as { title: string; description: string };
const title = homeMeta.title;
const description = homeMeta.description;
const canonicalPath = localizedPath(locale, { kind: "home" });
const alternates = await getAlternateLinksForRoute(Astro.site, { kind: "home" });
const robotsDirectives = robotsForTranslationState(await getRouteTranslationState({ kind: "home", locale }));
const homeUrl = new URL(canonicalPath, Astro.site).toString();
const organizationLogoUrl = new URL("/apple-touch-icon.png", Astro.site).toString();
const jsonLd = home.jsonLd as Record<string, any>;
const faqItems = Array.isArray(jsonLd.faq) ? jsonLd.faq : [];
const softwareOffers = Array.isArray(jsonLd.offers)
    ? jsonLd.offers.map((offer: Record<string, any>) => ({
        "@type": "Offer",
        ...offer,
    }))
    : undefined;
const extraHeadHtml = [
    jsonLdScript({
        "@context": "https://schema.org",
        "@type": "WebSite",
        inLanguage: locale,
        name: jsonLdBrand.websiteName,
        alternateName: jsonLd.websiteAlternateName,
        url: homeUrl,
    }),
    jsonLdScript({
        "@context": "https://schema.org",
        "@type": "Organization",
        inLanguage: locale,
        name: jsonLdBrand.organizationName,
        url: homeUrl,
        logo: organizationLogoUrl,
        sameAs: jsonLd.urls?.sameAs,
        contactPoint: {
            "@type": "ContactPoint",
            contactType: jsonLd.organizationContactType,
        },
    }),
    jsonLdScript({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        inLanguage: locale,
        name: jsonLdBrand.softwareName,
        description: jsonLd.softwareDescription,
        applicationCategory: jsonLd.applicationCategory,
        operatingSystem: jsonLd.operatingSystem,
        browserRequirements: jsonLd.browserRequirements,
        featureList: jsonLd.featureList,
        image: jsonLd.urls?.screenshot,
        url: homeUrl,
        offers: softwareOffers,
    }),
    jsonLdScript({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: locale,
        mainEntity: faqItems.map((item: any) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
            },
        })),
    }),
    jsonLdScript({
        "@context": "https://schema.org",
        "@type": "WebPage",
        inLanguage: locale,
        name: title,
        description,
        url: homeUrl,
    }),
].join("\n");
---

<BaseLayout
    title={title}
    description={description}
    canonicalPath={canonicalPath}
    ogImagePath="/og.jpg"
    locale={locale}
    alternates={alternates}
    robotsDirectives={robotsDirectives}
    extraHeadHtml={extraHeadHtml}
>
    <Nav locale={locale} messages={messages} />
    <main class="relative isolate">
        <HeroBackground />
        <Hero hero={homeSections.hero}>
            <div class="mt-10 w-full">
                <InboxHeroMockup inboxHeroMockup={homeSections.inboxHeroMockup} />
            </div>
        </Hero>
        <Logos logos={homeSections.logos} />
        <ShowcaseContainer>
            <CategorizationShowcase categorizationShowcase={homeSections.categorizationShowcase} />
            <DraftShowcase draftShowcase={homeSections.draftShowcase} />
            <AgentChatShowcase agentChatShowcase={homeSections.agentChatShowcase} />
        </ShowcaseContainer>
        <Testimonials testimonials={homeSections.testimonials} />
        <Pricing pricing={homeSections.pricing} />
        <FAQ faq={homeSections.faq} />
    </main>
    <FinalCTA finalCta={homeSections.finalCta} />
    <Footer locale={locale} messages={messages} alternates={alternates} />
</BaseLayout>
